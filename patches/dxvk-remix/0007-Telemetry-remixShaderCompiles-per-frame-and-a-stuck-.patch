+  DxvkRemixCompileStatus DxvkStateCache::remixCompileStatus() {
+    DxvkRemixCompileStatus status;
+    const auto now = std::chrono::steady_clock::now();
+    std::unique_lock<dxvk::mutex> lock(m_workerLock);
+    status.inFlight = m_workerCompilingRemixShaders.load();
+    status.compiling = uint32_t(m_remixCompiling.size());
+    status.completed = m_remixShadersCompiled.load();
+    for (const auto& entry : m_remixCompiling) {
+      const double ageMs = std::chrono::duration<double, std::milli>(now - entry.second.start).count();
+      if (ageMs >= status.oldestAgeMs) {
+        status.oldestAgeMs = ageMs;
+        status.oldestName = entry.second.name;
+      }
+    }
+    return status;
+  }
