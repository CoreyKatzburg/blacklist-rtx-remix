+  // While ray tracing is enabled and Remix shaders are queued or compiling, Remix does not ray trace and throttles every
+  // frame. Name the oldest compile once when that wait passes kStuckCompileWaitMs, so a launch that never ray traces says
+  // whether one compile never returned (oldest age close to the wait) or compiles keep arriving (completed keeps rising).
+  // Log every wait of a second or more when it ends.
+  void RtxContext::logRemixCompileWait(bool waiting) {
+    constexpr double kStuckCompileWaitMs = 30000.0;
+    const auto now = std::chrono::steady_clock::now();
+    if (waiting && !m_compileWaitActive) {
+      m_compileWaitActive = true;
+      m_compileWaitLogged = false;
+      m_compileWaitStart = now;
+    }
+    if (!m_compileWaitActive) {
+      return;
+    }
+    const double waitMs = std::chrono::duration<double, std::milli>(now - m_compileWaitStart).count();
+    if (waiting && !m_compileWaitLogged && waitMs >= kStuckCompileWaitMs) {
+      const DxvkRemixCompileStatus s = getCommonObjects()->pipelineManager().remixCompileStatus();
+      const uint32_t queued = s.inFlight > s.compiling ? s.inFlight - s.compiling : 0u;
+      Logger::warn(str::format("[RTX Shader Compile] ray tracing has waited ", uint32_t(waitMs / 1000.0),
+                               " s for Remix shaders: ", s.inFlight, " in flight (", s.compiling, " compiling, ", queued,
+                               " queued), ", s.completed, " completed since launch, oldest compiling: ",
+                               s.oldestName.empty() ? std::string("none") : s.oldestName, " for ",
+                               uint32_t(s.oldestAgeMs / 1000.0), " s"));
+      m_compileWaitLogged = true;
+    }
+    if (!waiting) {
+      if (waitMs >= 1000.0) {
+        const DxvkRemixCompileStatus s = getCommonObjects()->pipelineManager().remixCompileStatus();
+        Logger::info(str::format("[RTX Shader Compile] wait ended after ", uint32_t(waitMs), " ms, ", s.completed,
+                                 " completed since launch"));
+      }
+      m_compileWaitActive = false;
+    }
+  }
+
