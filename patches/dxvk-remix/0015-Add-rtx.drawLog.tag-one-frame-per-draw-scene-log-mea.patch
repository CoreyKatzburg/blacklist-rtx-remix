+// NV-DXVK start: per-draw scene log (worker C, Nov 16)
+//
+// A measurement, not a fix: with rtx.drawLog.tag empty (the default) nothing is recorded and the only
+// cost is one bool test per draw. When the tag changes to a non-empty value, the next frame's draws are
+// recorded as they reach SceneManager::processDrawCallState, and at that frame's end one file is written:
+// gate\<tag>_remix_draws.tsv next to the game exe (the folder rtx.gateDumpTag writes to).
+//
+// Line format (tab separated key=value, so new keys can be appended without breaking readers):
+//   remixframe  frame=<Remix frame id, as telemetry "frame">  qpcMs=<telemetry qpcMs>  tag=<tag>  draws=<rows>
+//   remixdraw   one per draw, keys in this order:
+//     order      position among the draws that reached the scene this frame (0-based)
+//     dcid       D3D9 draw index this frame (DrawCallState::drawCallID; counts every draw Remix considered)
+//     ext        1 for a Remix API (external) draw, 0 for a game draw
+//     cam        CameraType (0 Main, 1 ViewModel, 2 Portal0, 3 Portal1, 4 Sky, 5 RenderToTexture, 6 Unknown)
+//     ignored    1 when the material is ignored (no instance is made)
+//     verts idx prims   vertex count, index count, triangles ((idx ? idx : verts) / 3)
+//     geom       geometry hash under rtx.geometryAssetHashRule (USD capture names meshes from this rule)
+//     mat        legacy material hash (the stage-0 image hash unless overridden)
+//     rmat       hash of the material Remix renders with (differs from mat when a replacement applies)
+//     rtype      0 opaque, 1 translucent, 2 ray portal
+//     t0 t0empty t0valid   stage-0 image hash, 1 when no image view is bound, 1 when the texture ref is valid
+//     t1         stage-1 image hash
+//     tc         DrawCallState::hasTextureCoordinates()
+//     tcsrc      where the texcoords came from: decl, vscapture (vertex shader output), texgen, none
+//     tcfmt tcstride tcoff   VkFormat, stride and offset-from-slice of the texcoord buffer (0 when none)
+//     ralbedo    1 when the rendered material's albedo texture is valid and has an image, 0 if not, -1 not opaque
+//     drawtrack  1 when this draw's albedo would be tracked (ralbedo 1 and tc 1), else 0
+//     inst       RtInstance id (0 when no instance)
+//     instmat    legacy material hash bound to that instance (the first draw of the instance this frame wins)
+//     instalbedo 1 when the instance's bound surface material has an albedo texture index, 0 if not, -1 not opaque
+//     blasmat    legacy material hash in the BLAS entry's input (what a USD capture keys the mesh with)
+//     capmesh    the USD capture's mesh hash for this draw (BLAS input hash under the asset rule)
+//     cap        1 while a USD capture is running, 0 otherwise
+//     capmat     1/0 whether mat is in the capture's materials, -1 when no capture
+//     capmeshmat 1/0 whether the capture's mesh entry for capmesh has its matHash in materials,
+//                -1 when no capture or the mesh is not captured yet
+//     capmeshmathash  that mesh entry's matHash (0 when none)
+
+namespace dxvk {
+
+  enum class DrawLogTexcoordSource : uint8_t { None = 0, Decl, VsCapture, Texgen };
+
+  inline const char* drawLogTexcoordSourceName(DrawLogTexcoordSource s) {
+    switch (s) {
+    case DrawLogTexcoordSource::Decl: return "decl";
+    case DrawLogTexcoordSource::VsCapture: return "vscapture";
+    case DrawLogTexcoordSource::Texgen: return "texgen";
+    default: return "none";
+    }
+  }
+
+  // Vertex capture writes positions and texcoord0 into one slice with one stride (d3d9_rtx.cpp prepareVertexCapture),
+  // so a texcoord buffer on the same buffer, at the same stride, as a captured position buffer came from the shader.
+  inline DrawLogTexcoordSource classifyDrawLogTexcoords(bool texcoordDefined, bool texgen, bool usesVertexShader,
+                                                        bool sameBufferAsPosition, bool sameStrideAsPosition,
+                                                        bool positionIsCaptured) {
+    if (texcoordDefined) {
+      if (usesVertexShader && positionIsCaptured && sameBufferAsPosition && sameStrideAsPosition) {
+        return DrawLogTexcoordSource::VsCapture;
+      }
+      return DrawLogTexcoordSource::Decl;
+    }
+    return texgen ? DrawLogTexcoordSource::Texgen : DrawLogTexcoordSource::None;
+  }
+
+  struct DrawLogRow {
+    uint32_t order = 0;
+    uint32_t dcid = 0;
+    bool ext = false;
+    int cam = 0;
+    bool ignored = false;
+    uint32_t verts = 0;
+    uint32_t idx = 0;
+    uint64_t geom = 0;
+    uint64_t mat = 0;
+    uint64_t rmat = 0;
+    int rtype = 0;
+    uint64_t t0 = 0;
+    bool t0empty = true;
+    bool t0valid = false;
+    uint64_t t1 = 0;
+    bool tc = false;
+    DrawLogTexcoordSource tcsrc = DrawLogTexcoordSource::None;
+    uint32_t tcfmt = 0;
+    uint32_t tcstride = 0;
+    uint32_t tcoff = 0;
+    int ralbedo = -1;
+    uint64_t inst = 0;
+    uint64_t instmat = 0;
+    int instalbedo = -1;
+    uint64_t blasmat = 0;
+    uint64_t capmesh = 0;
+    bool cap = false;
+    int capmat = -1;
+    int capmeshmat = -1;
+    uint64_t capmeshmathash = 0;
+  };
+
+  inline std::string formatDrawLogRow(const DrawLogRow& r) {
+    char buf[1024];
+    const uint32_t prims = (r.idx ? r.idx : r.verts) / 3;
+    const int drawtrack = (r.ralbedo == 1 && r.tc) ? 1 : 0;
+    std::snprintf(buf, sizeof(buf),
+      "remixdraw\torder=%u\tdcid=%u\text=%d\tcam=%d\tignored=%d\tverts=%u\tidx=%u\tprims=%u"
+      "\tgeom=%016llX\tmat=%016llX\trmat=%016llX\trtype=%d"
+      "\tt0=%016llX\tt0empty=%d\tt0valid=%d\tt1=%016llX"
+      "\ttc=%d\ttcsrc=%s\ttcfmt=%u\ttcstride=%u\ttcoff=%u"
+      "\tralbedo=%d\tdrawtrack=%d\tinst=%llu\tinstmat=%016llX\tinstalbedo=%d"
+      "\tblasmat=%016llX\tcapmesh=%016llX\tcap=%d\tcapmat=%d\tcapmeshmat=%d\tcapmeshmathash=%016llX\n",
+      r.order, r.dcid, r.ext ? 1 : 0, r.cam, r.ignored ? 1 : 0, r.verts, r.idx, prims,
+      (unsigned long long) r.geom, (unsigned long long) r.mat, (unsigned long long) r.rmat, r.rtype,
+      (unsigned long long) r.t0, r.t0empty ? 1 : 0, r.t0valid ? 1 : 0, (unsigned long long) r.t1,
+      r.tc ? 1 : 0, drawLogTexcoordSourceName(r.tcsrc), r.tcfmt, r.tcstride, r.tcoff,
+      r.ralbedo, drawtrack, (unsigned long long) r.inst, (unsigned long long) r.instmat, r.instalbedo,
+      (unsigned long long) r.blasmat, (unsigned long long) r.capmesh, r.cap ? 1 : 0, r.capmat, r.capmeshmat,
+      (unsigned long long) r.capmeshmathash);
+    return buf;
+  }
+
+  // Records one frame of rows on request. Not thread safe: every call comes from the render (CS) thread.
+  class DrawLog {
+  public:
+    bool active() const { return m_active; }
+
+    // Called once per frame end, after write(). Arms the next frame when tag is non-empty and differs from the last
+    // armed tag; an empty tag disarms and forgets the last tag, so the same tag can be asked for again later.
+    void armIfNewTag(const std::string& tag) {
+      if (tag.empty()) {
+        m_lastTag.clear();
+        return;
+      }
+      if (tag == m_lastTag) {
+        return;
+      }
+      m_lastTag = tag;
+      m_tag = tag;
+      m_rows.clear();
+      m_active = true;
+    }
+
+    void add(DrawLogRow row) {
+      row.order = static_cast<uint32_t>(m_rows.size());
+      m_rows.push_back(row);
+    }
+
+    // Writes the armed frame to <dir>\<tag>_remix_draws.tsv and disarms. Returns the path written, or "" when not
+    // armed or the write failed (the log is a measurement; a failed write changes nothing else).
+    std::string write(const std::filesystem::path& dir, uint64_t frameId, double qpcMs) {
+      if (!m_active) {
+        return {};
+      }
+      m_active = false;
+      std::string text;
+      char head[512];
+      std::snprintf(head, sizeof(head), "remixframe\tframe=%llu\tqpcMs=%.3f\ttag=%s\tdraws=%zu\n",
+                    (unsigned long long) frameId, qpcMs, m_tag.c_str(), m_rows.size());
+      text += head;
+      for (const DrawLogRow& r : m_rows) {
+        text += formatDrawLogRow(r);
+      }
+      m_rows.clear();
+      m_rows.shrink_to_fit();
+      std::error_code ec;
+      std::filesystem::create_directories(dir, ec);
+      const std::filesystem::path path = dir / (m_tag + "_remix_draws.tsv");
+      const std::filesystem::path tmp = dir / (m_tag + "_remix_draws.tsv.tmp");
+      FILE* f = nullptr;
+      if (_wfopen_s(&f, tmp.c_str(), L"wb") != 0 || f == nullptr) {
+        return {};
+      }
+      const bool ok = std::fwrite(text.data(), 1, text.size(), f) == text.size();
+      std::fclose(f);
+      if (!ok) {
+        std::filesystem::remove(tmp, ec);
+        return {};
+      }
+      std::filesystem::rename(tmp, path, ec);
+      return ec ? std::string() : path.string();
+    }
+
+  private:
+    bool m_active = false;
+    std::string m_tag;
+    std::string m_lastTag;
+    std::vector<DrawLogRow> m_rows;
+  };
+
+}
+// NV-DXVK end
