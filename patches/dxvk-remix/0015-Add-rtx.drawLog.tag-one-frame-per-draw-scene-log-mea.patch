+  GameCapturer::DrawLogCaptureInfo GameCapturer::drawLogCaptureInfo(XXH64_hash_t meshHash, XXH64_hash_t matHash) {
+    DrawLogCaptureInfo info;
+    if (!m_state.has<State::Capturing>() || m_pCap == nullptr) {
+      return info;
+    }
+    info.capturing = true;
+    info.matCaptured = m_pCap->materials.count(matHash) > 0 ? 1 : 0;
+    std::lock_guard lock(m_meshMutex);
+    const auto it = m_pCap->meshes.find(meshHash);
+    if (it != m_pCap->meshes.end() && it->second != nullptr) {
+      info.meshMatHash = it->second->matHash;
+      info.meshMatCaptured = m_pCap->materials.count(info.meshMatHash) > 0 ? 1 : 0;
+    }
+    return info;
+  }
