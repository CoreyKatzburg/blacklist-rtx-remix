+  void SceneManager::addDrawLogRow(const DrawCallState& drawCallState, const MaterialData& renderMaterialData,
+                                   const RtInstance* instance) {
+    const RasterGeometry& geo = drawCallState.getGeometryData();
+    const LegacyMaterialData& legacy = drawCallState.getMaterialData();
+    const HashRule& assetRule = RtxOptions::geometryAssetHashRule();
+
+    DrawLogRow r;
+    r.dcid = drawCallState.drawCallID;
+    r.ext = m_drawLogExternal;
+    r.cam = static_cast<int>(drawCallState.cameraType);
+    r.ignored = renderMaterialData.getIgnored();
+    r.verts = geo.vertexCount;
+    r.idx = geo.indexCount;
+    r.geom = geo.getHashForRule(assetRule);
+    r.mat = legacy.getHash();
+    r.rmat = renderMaterialData.getHash();
+    r.rtype = static_cast<int>(renderMaterialData.getType());
+    r.t0 = legacy.getColorTexture().getImageHash();
+    r.t0empty = legacy.getColorTexture().isImageEmpty();
+    r.t0valid = legacy.getColorTexture().isValid();
+    r.t1 = legacy.getColorTexture2().getImageHash();
+    r.tc = drawCallState.hasTextureCoordinates();
+
+    const RasterBuffer& tcBuf = geo.texcoordBuffer;
+    const RasterBuffer& posBuf = geo.positionBuffer;
+    const bool tcDefined = tcBuf.defined();
+    const bool posCaptured = posBuf.defined() && posBuf.stride() == sizeof(CapturedVertex) &&
+                             posBuf.vertexFormat() == VK_FORMAT_R32G32B32A32_SFLOAT;
+    r.tcsrc = classifyDrawLogTexcoords(tcDefined, drawCallState.getTransformData().texgenMode != TexGenMode::None,
+                                       drawCallState.usesVertexShader,
+                                       tcDefined && posBuf.defined() && tcBuf.buffer() == posBuf.buffer(),
+                                       tcDefined && tcBuf.stride() == posBuf.stride(), posCaptured);
+    if (tcDefined) {
+      r.tcfmt = static_cast<uint32_t>(tcBuf.vertexFormat());
+      r.tcstride = tcBuf.stride();
+      r.tcoff = tcBuf.offsetFromSlice();
+    }
+
+    if (renderMaterialData.getType() == MaterialDataType::Opaque) {
+      const TextureRef& albedo = renderMaterialData.getOpaqueMaterialData().getAlbedoOpacityTexture();
+      r.ralbedo = (albedo.isValid() && !albedo.isImageEmpty()) ? 1 : 0;
+    }
+
+    if (instance != nullptr) {
+      r.inst = instance->getId();
+      r.instmat = instance->getMaterialDataHash();
+      const uint32_t surfaceIdx = instance->surface.surfaceMaterialIndex;
+      if (surfaceIdx < m_surfaceMaterialCache.getTotalCount()) {
+        const RtSurfaceMaterial& surface = m_surfaceMaterialCache.getObjectTable()[surfaceIdx];
+        if (surface.getType() == RtSurfaceMaterialType::Opaque) {
+          r.instalbedo = surface.getOpaqueSurfaceMaterial().getAlbedoOpacityTextureIndex() !=
+                         kSurfaceMaterialInvalidTextureIndex ? 1 : 0;
+        }
+      }
+      if (const BlasEntry* pBlas = instance->getBlas()) {
+        r.blasmat = pBlas->input.getMaterialData().getHash();
+        r.capmesh = pBlas->input.getHash(assetRule);
+      }
+    }
+
+    if (auto capturer = m_device->getCommon()->capturer(); capturer != nullptr) {
+      const GameCapturer::DrawLogCaptureInfo info = capturer->drawLogCaptureInfo(r.capmesh, r.mat);
+      r.cap = info.capturing;
+      r.capmat = info.matCaptured;
+      r.capmeshmat = info.meshMatCaptured;
+      r.capmeshmathash = info.meshMatHash;
+    }
+
+    m_drawLog.add(r);
+  }
