+  // Fills zeroNormalInstances, zeroNormalStaticInstances and topInwardInstances (skinned only) from the gated
+  // instances, whose counts were already read back. Ties keep dispatch order.
+  inline void summarizeGateInstances(const std::vector<RtxGateInstance>& instances, RtxFrameTelemetry& out) {
+    out.zeroNormalInstances = 0;
+    out.zeroNormalStaticInstances = 0;
+    out.topInwardInstances.clear();
+    for (const RtxGateInstance& inst : instances) {
+      if (inst.zeroNormal > 0) {
+        ++(inst.skinned ? out.zeroNormalInstances : out.zeroNormalStaticInstances);
+      }
+      if (inst.skinned && inst.inward > 0) {
+        out.topInwardInstances.push_back(inst);
+      }
+    }
+    std::stable_sort(out.topInwardInstances.begin(), out.topInwardInstances.end(),
+      [](const RtxGateInstance& a, const RtxGateInstance& b) { return a.inward > b.inward; });
+    if (out.topInwardInstances.size() > kTopInwardInstances) {
+      out.topInwardInstances.resize(kTopInwardInstances);
+    }
+  }
