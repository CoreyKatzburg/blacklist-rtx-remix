-    m_parent->EmitCs([currentReflexFrameId, targetImage, callInjectRtx](DxvkContext* ctx) { 
-      static_cast<RtxContext*>(ctx)->endFrame(currentReflexFrameId, targetImage, callInjectRtx); 
+    // NV-DXVK start: stamp the frame record with the proxy's clock (telemetry qpcMs)
+    m_parent->EmitCs([currentReflexFrameId, targetImage, callInjectRtx, cQpcMs = telemetryQpcMs()](DxvkContext* ctx) {
+      static_cast<RtxContext*>(ctx)->getSceneManager().setTelemetryQpcMs(cQpcMs);
+      static_cast<RtxContext*>(ctx)->endFrame(currentReflexFrameId, targetImage, callInjectRtx);
     });
+    // NV-DXVK end
 
