+  // NV-DXVK start: telemetry qpcMs
+  // QueryPerformanceCounter in ms, the same clock and formula as d3d9_proxy_frames.csv column 2, so the
+  // telemetry and proxy files can be joined frame by frame.
+  static double telemetryQpcMs() {
+    return double(high_resolution_clock::getCounter()) * 1000.0 / double(high_resolution_clock::getFrequency());
+  }
+  // NV-DXVK end
+
   void D3D9Rtx::triggerInjectRTX() {
     // Flush any pending game and RTX work
     m_parent->Flush();
 
     // Send command to inject RTX
-    m_parent->EmitCs([cReflexFrameId = GetReflexFrameId()](DxvkContext* ctx) {
+    // NV-DXVK start: stamp the frame record with the proxy's clock (telemetry qpcMs)
+    m_parent->EmitCs([cReflexFrameId = GetReflexFrameId(), cQpcMs = telemetryQpcMs()](DxvkContext* ctx) {
+      static_cast<RtxContext*>(ctx)->getSceneManager().setTelemetryQpcMs(cQpcMs);
       static_cast<RtxContext*>(ctx)->injectRTX(cReflexFrameId);
     });
+    // NV-DXVK end
   }
 
   void D3D9Rtx::CommitGeometryToRT(const DrawContext& drawContext) {
@@ -1307,9 +1318,12 @@ namespace dxvk {
     m_parent->Flush();
 
