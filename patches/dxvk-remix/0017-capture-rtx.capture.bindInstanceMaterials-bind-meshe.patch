index 0000000..ad01fc1
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_capture_binding.h
@@ -0,0 +1,70 @@
+#pragma once
+
+// Material binding decisions of a USD capture export (GameCapturer::prepExportMeshes / prepExportInstances), kept
+// free of Remix types so tests/remix_source/capture_binding_test.cpp can drive them with fakes.
+//
+// Upstream rule: a captured mesh keeps the material hash of the first instance GameCapturer::newInstance registered
+// for it (the order of the scene's instance table, which still holds instances drawn last frame and is reordered by
+// swap-erase). The mesh, and every one of its instances, binds a material only when that one hash is a captured
+// material. When the first instance is left over from the previous frame, its hash is usually unknown to the BLAS:
+// BlasEntry::getMaterialData then returns the BLAS input material, which captureMaterial stores under its own hash,
+// so the first instance's hash never becomes a captured material and the whole mesh exports unbound, even though
+// the material of the instances drawn this frame is captured.
+//
+// rtx.capture.bindInstanceMaterials (default off) adds bindings and never removes one: an instance whose own hash
+// is captured binds it, and a mesh whose first hash is not captured binds the captured hash of its lowest-numbered
+// instance. Everything that binds with the option off exports exactly as before.
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+namespace dxvk {
+  namespace capture_binding {
+
+    // Tracks, per mesh, the captured material hash of its lowest-numbered instance (meshInstNum).
+    struct Fallback {
+      std::optional<uint64_t> hash;
+      size_t instNum = 0;
+
+      template<typename IsCaptured>
+      void offer(size_t num, uint64_t instHash, IsCaptured isCaptured) {
+        if (!isCaptured(instHash)) {
+          return;
+        }
+        if (!hash.has_value() || num < instNum) {
+          hash = instHash;
+          instNum = num;
+        }
+      }
+    };
+
+    // Material the exported mesh prim binds, or nullopt for none.
+    template<typename IsCaptured>
+    std::optional<uint64_t> meshMaterial(uint64_t meshMatHash, const Fallback& fallback, IsCaptured isCaptured,
+                                         bool bindInstanceMaterials) {
+      if (isCaptured(meshMatHash)) {
+        return meshMatHash;
+      }
+      if (bindInstanceMaterials && fallback.hash.has_value()) {
+        return fallback.hash;
+      }
+      return std::nullopt;
+    }
+
+    // Material an exported instance binds, or nullopt for none. With the mesh's first hash captured this is the
+    // upstream rule unchanged (the instance's own hash, captured or not).
+    template<typename IsCaptured>
+    std::optional<uint64_t> instanceMaterial(uint64_t meshMatHash, uint64_t instMatHash, IsCaptured isCaptured,
+                                             bool bindInstanceMaterials) {
+      if (isCaptured(meshMatHash)) {
+        return instMatHash;
+      }
+      if (bindInstanceMaterials && isCaptured(instMatHash)) {
+        return instMatHash;
+      }
+      return std::nullopt;
+    }
+
+  }
+}
