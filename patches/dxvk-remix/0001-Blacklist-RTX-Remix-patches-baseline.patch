diff --git a/src/dxvk/rtx_render/rtx_instance_trace_class.h b/src/dxvk/rtx_render/rtx_instance_trace_class.h
new file mode 100644
index 0000000..c4ca3da
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_instance_trace_class.h
@@ -0,0 +1,72 @@
+#pragma once
+
+// NV-DXVK start: instance trace classification
+namespace dxvk {
+
+  // How an instance is traced, decided from the state of the draw that updated it.
+  // Every update recomputes it from scratch. In particular "unordered" (the separate TLAS for
+  // blended/particle geometry) must not stick: Blacklist draws Sam blended for a few frames during
+  // its close-camera fade, then opaque again, and a sticky flag kept him in the unordered TLAS.
+  struct InstanceTraceInputs {
+    bool isOpaqueMaterial = true;          // material type is Opaque (not Translucent / RayPortal)
+    bool isTranslucentMaterial = false;
+    bool isRayPortalMaterial = false;
+    bool usesRaytracedRenderTarget = false;
+    bool isFullyOpaque = true;             // alpha state
+    bool isParticle = false;
+    bool isDecal = false;
+    bool isBlendingDisabled = true;
+    bool emissiveBlend = false;
+    bool isPlayerModel = false;
+    bool isClipPlaneEnabled = false;
+  };
+
+  enum class TraceGeometry {
+    Opaque,                     // VK_GEOMETRY_OPAQUE_BIT_KHR
+    NonOpaqueSingleAnyHit,      // VK_GEOMETRY_NO_DUPLICATE_ANY_HIT_INVOCATION_BIT_KHR
+    NonOpaque,                  // no flags (alpha tested, duplicate any-hits allowed)
+  };
+
+  struct InstanceTraceClass {
+    TraceGeometry geometry = TraceGeometry::Opaque;
+    bool isUnordered = false;    // goes to the unordered TLAS
+    bool forceNoOpaque = false;  // VK_GEOMETRY_INSTANCE_FORCE_NO_OPAQUE_BIT_KHR
+  };
+
+  inline InstanceTraceClass classifyInstanceForTracing(const InstanceTraceInputs& in) {
+    InstanceTraceClass out;
+    if (in.isOpaqueMaterial && in.usesRaytracedRenderTarget) {
+      // Render target texture: needs the opaque pass even if not fully opaque.
+      out.geometry = TraceGeometry::NonOpaqueSingleAnyHit;
+    } else if ((!in.isFullyOpaque && in.isParticle) ||
+               in.isDecal ||
+               // Alpha blended geometry on the player model goes to the unordered TLAS too.
+               (!in.isFullyOpaque && !in.isBlendingDisabled && in.isPlayerModel) ||
+               in.emissiveBlend) {
+      // Alpha-blended and emissive particles: separate unordered TLAS, any-hit only.
+      out.geometry = TraceGeometry::NonOpaqueSingleAnyHit;
+      out.isUnordered = true;
+      out.forceNoOpaque = true;
+    } else if (in.isOpaqueMaterial && !in.isFullyOpaque && in.isBlendingDisabled) {
+      // Alpha tested: primary TLAS, non-opaque with potential duplicate hits.
+      out.geometry = TraceGeometry::NonOpaque;
+    } else if (in.isOpaqueMaterial && !in.isFullyOpaque) {
+      // Alpha blended: primary TLAS, non-opaque, every hit an any-hit.
+      out.geometry = TraceGeometry::NonOpaqueSingleAnyHit;
+      out.forceNoOpaque = true;
+    } else if (in.isTranslucentMaterial) {
+      out.geometry = TraceGeometry::NonOpaqueSingleAnyHit;
+    } else if (in.isRayPortalMaterial) {
+      out.geometry = TraceGeometry::Opaque;
+    } else if (in.isClipPlaneEnabled) {
+      // Non-opaque hits process clip planes on visibility rays (force bit avoids BLAS confusion).
+      out.geometry = TraceGeometry::Opaque;
+      out.forceNoOpaque = true;
+    } else {
+      out.geometry = TraceGeometry::Opaque;
+    }
+    return out;
+  }
+
+}
+// NV-DXVK end
