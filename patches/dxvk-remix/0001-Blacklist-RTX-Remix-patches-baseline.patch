+namespace {
+  std::map<uint32_t, IDirect3DQuery9*> g_occlusionQueries;
+  IDirect3DDevice9* g_primaryStatusDevice = nullptr;
+
+  void pollOcclusionQueriesNonBlocking() {
+    if (g_occlusionQueries.empty()) {
+      return;
+    }
+    for (auto& [handle, query] : g_occlusionQueries) {
+      if (!query) continue;
+      DWORD pixels = 0;
+      const HRESULT hr = query->GetData(&pixels, sizeof(DWORD), 0);
+      if (hr == S_OK) {
+        if (auto* slot = bridge_fast_status::findOrClaimOcclusionSlot(handle, true)) {
+          slot->lastPixels.store(pixels, std::memory_order_relaxed);
+          slot->completedSeq.fetch_add(1, std::memory_order_release);
+        }
+      }
+    }
+  }
+
+  void publishFastDeviceStatus(IDirect3DDevice9* dev, bool refreshDisplayMode) {
+    if (!dev) return;
+    g_primaryStatusDevice = dev;
+    auto* sb = bridge_fast_status::getBlock();
+    if (!sb) return;
+    sb->availableTextureMem.store(dev->GetAvailableTextureMem(), std::memory_order_relaxed);
+    sb->deviceState.store(static_cast<int32_t>(((IDirect3DDevice9Ex*) dev)->CheckDeviceState(nullptr)), std::memory_order_relaxed);
+    sb->statusValid.store(1, std::memory_order_release);
+    if (refreshDisplayMode) {
+      D3DDISPLAYMODE mode = {};
+      if (SUCCEEDED(dev->GetDisplayMode(0, &mode))) {
+        sb->displayWidth.store(mode.Width, std::memory_order_relaxed);
+        sb->displayHeight.store(mode.Height, std::memory_order_relaxed);
+        sb->displayRefreshRate.store(mode.RefreshRate, std::memory_order_relaxed);
+        sb->displayFormat.store(static_cast<uint32_t>(mode.Format), std::memory_order_relaxed);
+        sb->displayScanLineOrdering.store(static_cast<uint32_t>(D3DSCANLINEORDERING_PROGRESSIVE), std::memory_order_relaxed);
+        sb->displayRotation.store(static_cast<uint32_t>(D3DDISPLAYROTATION_IDENTITY), std::memory_order_relaxed);
+        D3DDISPLAYMODEEX modeEx = {};
+        modeEx.Size = sizeof(modeEx);
+        D3DDISPLAYROTATION rot = D3DDISPLAYROTATION_IDENTITY;
+        if (SUCCEEDED(((IDirect3DDevice9Ex*) dev)->GetDisplayModeEx(0, &modeEx, &rot))) {
+          sb->displayScanLineOrdering.store(static_cast<uint32_t>(modeEx.ScanLineOrdering), std::memory_order_relaxed);
+          sb->displayRotation.store(static_cast<uint32_t>(rot), std::memory_order_relaxed);
+        }
+        sb->displayValid.store(1, std::memory_order_release);
+      }
+    }
+  }
+}
