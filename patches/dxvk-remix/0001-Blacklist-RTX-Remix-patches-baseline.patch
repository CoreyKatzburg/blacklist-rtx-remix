+#pragma once
+
+// NV-DXVK start: camera cut threshold
+namespace dxvk {
+
+  // A camera that jumps further than this in one frame is a "cut": Remix drops temporal history and
+  // flushes the scene. In a recorded Blacklist session, ordinary gameplay jumps (sprints, takedowns,
+  // cover swaps) were 318-605 units and real teleports (checkpoints, cutscenes) were 3388-6686 units.
+  constexpr float kDefaultCameraCutDistance = 1200.0f;
+
+  inline bool isCameraCutJump(float jumpDistanceSqr, float cutDistance) {
+    return jumpDistanceSqr > cutDistance * cutDistance;
+  }
+
+}
+// NV-DXVK end
