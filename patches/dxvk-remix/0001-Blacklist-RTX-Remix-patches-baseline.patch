+  };
+
+  using RtxTelemetryResolver = std::function<void(RtxFrameTelemetry&)>;
+
+  // Formats one JSON line (with trailing '\n'). Returns the length, or 0 if it did not fit.
+  inline size_t formatTelemetryLine(char* buffer, size_t size, const RtxFrameTelemetry& t) {
+    size_t used = 0;
+    bool fits = size > 0;
+    auto add = [&](const char* format, auto... args) {
+      const int n = fits ? std::snprintf(buffer + used, size - used, format, args...) : -1;
+      fits = n >= 0 && used + size_t(n) < size;
+      used += fits ? size_t(n) : 0;
+    };
+    add("{\"frame\":%llu,\"frameTimeMs\":%.3f,\"gpuTimeMs\":%.3f,\"instances\":%u,\"skinnedInstances\":%u,"
+      "\"staticBlasRebuilds\":%u,\"cameraCut\":%s,\"textureMemoryMB\":%.1f,\"vramUsedMB\":%.1f,"
+      "\"staticBlasBuilds\":%u,\"skinnedBlasUpdates\":%u,\"unorderedInstances\":%u,"
+      "\"skinnedTriangles\":%u,\"inwardSkinnedTriangles\":%u",
+      static_cast<unsigned long long>(t.frame), t.frameTimeMs, t.gpuTimeMs, t.instances, t.skinnedInstances,
+      t.staticBlasRebuilds, t.cameraCut ? "true" : "false", t.textureMemoryMB, t.vramUsedMB,
+      t.staticBlasBuilds, t.skinnedBlasUpdates, t.unorderedInstances,
+      t.skinnedTriangles, t.inwardSkinnedTriangles);
+    add(",\"rayTraced\":%s,\"telemetryCpuMs\":%.3f,\"replacedMaterialDraws\":%u,\"legacyMaterialDraws\":%u,"
+      "\"texturesDemoted\":%u,\"textureBudgetMB\":%.1f,\"thumbNonFinite\":%u,\"thumbClipped\":%u,\"skips\":{",
+      t.rayTraced ? "true" : "false", t.telemetryCpuMs, t.replacedMaterialDraws, t.legacyMaterialDraws,
+      t.texturesDemoted, t.textureBudgetMB, t.thumbNonFinite, t.thumbClipped);
+    const char* comma = "";
+    for (size_t i = 0; i < size_t(RtxSkip::Count); i++) {
+      if (t.skips[i] != 0) {
+        add("%s\"%s\":%u", comma, kRtxSkipNames[i], t.skips[i]);
+        comma = ",";
+      }
+    }
+    add("},\"passMs\":{");
+    comma = "";
+    for (const RtxPassTime& pass : t.passes) {
+      add("%s\"%s\":[%.3f,%.3f,%u]", comma, pass.path.c_str(), pass.gpuMs, pass.cpuMs, pass.count);
+      comma = ",";
+    }
+    add("}");
+    if (!t.newLegacyMaterials.empty()) {
+      add(",\"newLegacyMaterials\":[");
+      comma = "";
+      for (uint64_t hash : t.newLegacyMaterials) {
+        add("%s\"%016llX\"", comma, static_cast<unsigned long long>(hash));
+        comma = ",";
+      }
+      add("]");
+    }
+    if (!t.rgbThumb.empty()) {
+      add(",\"rgbThumb\":\"%s\"", t.rgbThumb.c_str());
+    }
+    if (!t.lumaThumb.empty()) {
+      add(",\"lumaThumb\":\"%s\"", t.lumaThumb.c_str());
+    }
+    add("}\n");
+    return fits ? used : 0;
+  }
+
+  class RtxTelemetryWriter {
+  public:
+    explicit RtxTelemetryWriter(const std::string& path) {
+      m_file = std::fopen(path.c_str(), "wb");
+      if (m_file != nullptr) {
+        m_thread = std::thread([this] { writerLoop(); });
+      }
+    }
+
+    ~RtxTelemetryWriter() {
+      shutdown();
+    }
+
+    RtxTelemetryWriter(const RtxTelemetryWriter&) = delete;
+    RtxTelemetryWriter& operator=(const RtxTelemetryWriter&) = delete;
+
+    bool isOpen() const { return m_file != nullptr; }
+
+    void shutdown() {
+      if (m_file == nullptr) {
+        return;
+      }
+      {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_stop = true;
+      }
+      m_wake.notify_one();
+      if (m_thread.joinable()) {
+        m_thread.join();
+      }
+      std::fclose(m_file);
+      m_file = nullptr;
+    }
+
+    void push(RtxFrameTelemetry frame, RtxTelemetryResolver resolve = {}) {
+      if (m_file == nullptr) {
+        return;
+      }
+      bool wake = false;
+      {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const bool hasGpuWork = static_cast<bool>(resolve);
+        m_items.push_back(PendingItem { std::move(frame), std::move(resolve) });
+        wake = hasGpuWork || m_items.size() >= kFlushItems;
+      }
+      if (wake) {
+        m_wake.notify_one();
+      }
+    }
+
+  private:
+    struct PendingItem {
+      RtxFrameTelemetry frame;
+      RtxTelemetryResolver resolve;
+    };
+
+    static constexpr size_t kFlushItems = 64;
+    static constexpr size_t kLineBufferBytes = 65536;   // both thumbnails are 21.5 KB of base64
+    static constexpr auto kFlushInterval = std::chrono::milliseconds(250);
+
+    void writerLoop() {
+      std::deque<PendingItem> batch;
+      std::vector<char> lineBuf(kLineBufferBytes);
+      std::string outBytes;
+      outBytes.reserve(64 * 1024);
+
+      std::unique_lock<std::mutex> lock(m_mutex);
+      while (true) {
+        m_wake.wait_for(lock, kFlushInterval, [this] { return m_stop || !m_items.empty(); });
+        batch.swap(m_items);
+        const bool stop = m_stop;
+        lock.unlock();
+
+        if (!batch.empty()) {
+          for (PendingItem& item : batch) {
+            if (item.resolve) {
+              item.resolve(item.frame);
+            }
+            const size_t n = formatTelemetryLine(lineBuf.data(), lineBuf.size(), item.frame);
+            if (n > 0) {
+              outBytes.append(lineBuf.data(), n);
+            }
+            if (outBytes.size() >= 32 * 1024) {
+              std::fwrite(outBytes.data(), 1, outBytes.size(), m_file);
+              std::fflush(m_file);
+              outBytes.clear();
+            }
+          }
+          batch.clear();
+          if (!outBytes.empty()) {
+            std::fwrite(outBytes.data(), 1, outBytes.size(), m_file);
+            std::fflush(m_file);
+            outBytes.clear();
+          }
+        }
+
+        if (stop) {
+          return;
+        }
+        lock.lock();
+      }
+    }
+
+    std::FILE* m_file = nullptr;
+    std::thread m_thread;
+    std::mutex m_mutex;
+    std::condition_variable m_wake;
+    // A deque, so a growing queue never copies the records already in it while the render thread waits.
+    std::deque<PendingItem> m_items;
+    bool m_stop = false;
+  };
+
+}
