+  // Skipped draws since the last frame record. The draw thread adds, the render thread reads and zeroes.
+  inline std::atomic<uint32_t> g_rtxSkips[size_t(RtxSkip::Count)];
+  inline void countRtxSkip(RtxSkip reason) {
+    g_rtxSkips[size_t(reason)].fetch_add(1, std::memory_order_relaxed);
