diff --git a/src/dxvk/shaders/rtx/pass/gate_skinned_triangles.comp.slang b/src/dxvk/shaders/rtx/pass/gate_skinned_triangles.comp.slang
new file mode 100644
index 0000000..aaba874
--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/gate_skinned_triangles.comp.slang
@@ -0,0 +1,86 @@
+/*
+* Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+*/
+#include "gate_skinned_triangles_binding_indices.h"
+#include "rtx/utility/packing.slangh"
+
+layout(binding = GATE_SKINNED_TRIANGLES_BINDING_POSITION_RO)
+StructuredBuffer<float> positionData;
+
+layout(binding = GATE_SKINNED_TRIANGLES_BINDING_NORMAL_RO)
+StructuredBuffer<float> normalData;
+
+layout(binding = GATE_SKINNED_TRIANGLES_BINDING_INDEX_RO)
+StructuredBuffer<uint> indexData;
+
+layout(binding = GATE_SKINNED_TRIANGLES_BINDING_COUNTERS_RW)
+RWStructuredBuffer<uint> outCounters;
+
+layout(push_constant)
+ConstantBuffer<GateSkinnedTrianglesArgs> cb;
+
+uint loadVertexIndex(uint corner) {
+  if ((cb.flags & GATE_SKINNED_FLAG_INDEXED) == 0u) {
+    return corner;
+  }
+  if ((cb.flags & GATE_SKINNED_FLAG_SHORT_INDICES) != 0u) {
+    const uint wordIdx = corner >> 1;
+    const uint shift = (corner & 1u) * 16u;
+    const uint packed = indexData[(cb.indexOffset >> 2) + wordIdx];
+    return (packed >> shift) & 0xFFFFu;
+  }
+  return indexData[(cb.indexOffset >> 2) + corner];
+}
+
+float3 loadWorldPosition(uint v) {
+  const uint base = (cb.positionOffset >> 2) + v * (cb.positionStride >> 2);
+  const float3 p = float3(positionData[base + 0u], positionData[base + 1u], positionData[base + 2u]);
+  return cb.objToWorld0.xyz * p.x + cb.objToWorld1.xyz * p.y + cb.objToWorld2.xyz * p.z;
+}
+
+float3 loadWorldNormal(uint v) {
+  const uint base = (cb.normalOffset >> 2) + v * (cb.normalStride >> 2);
+  float3 n;
+  if ((cb.flags & GATE_SKINNED_FLAG_NORMALS_ENCODED) != 0u) {
+    const uint enc = asuint(normalData[base]);
+    n = unsignedOctahedralToSphereDirection(vec2(
+      unorm16ToF32(uint16_t(enc & 0xFFFFu)),
+      unorm16ToF32(uint16_t(enc >> 16))));
+  } else {
+    n = float3(normalData[base + 0u], normalData[base + 1u], normalData[base + 2u]);
+  }
+  const float3 wn = cb.normToWorld0.xyz * n.x + cb.normToWorld1.xyz * n.y + cb.normToWorld2.xyz * n.z;
+  const float lenSq = dot(wn, wn);
+  return lenSq > 1e-24f ? (wn * rsqrt(lenSq)) : float3(0.0f, 0.0f, 0.0f);
+}
+
+[shader("compute")]
+[numthreads(128, 1, 1)]
+void main(uint triIdx : SV_DispatchThreadID) {
+  if (triIdx >= cb.numTriangles) {
+    return;
+  }
+
+  const uint i0 = loadVertexIndex(triIdx * 3u + 0u);
+  const uint i1 = loadVertexIndex(triIdx * 3u + 1u);
+  const uint i2 = loadVertexIndex(triIdx * 3u + 2u);
+
+  const float3 w0 = loadWorldPosition(i0);
+  const float3 w1 = loadWorldPosition(i1);
+  const float3 w2 = loadWorldPosition(i2);
+
+  const float signFlip = ((cb.flags & GATE_SKINNED_FLAG_FLIP_WINDING) != 0u) ? -1.0f : 1.0f;
+  const float3 face = cross(w1 - w0, w2 - w0) * signFlip;
+  if (dot(face, face) <= 1e-24f) {
+    return;
+  }
+
+  const float3 meanN = loadWorldNormal(i0) + loadWorldNormal(i1) + loadWorldNormal(i2);
+  if (dot(meanN, meanN) <= 1e-24f) {
+    return;
+  }
+
+  if (dot(face, meanN) < 0.0f) {
+    InterlockedAdd(outCounters[cb.counterSlot], 1u);
+  }
+}
