+    void writePfmAtomic(const std::filesystem::path& finalPath, uint32_t w, uint32_t h, uint32_t channels, const float* topDownData) {
+      std::error_code ec;
+      std::filesystem::create_directories(finalPath.parent_path(), ec);
+      std::filesystem::path tmpPath = finalPath;
+      tmpPath += L".tmp";
+      std::FILE* f = _wfopen(tmpPath.wstring().c_str(), L"wb");
+      if (f == nullptr) {
+        return;
+      }
+      std::fprintf(f, "%s\n%u %u\n-1.0\n", channels == 3 ? "PF" : "Pf", w, h);
+      const size_t rowFloats = size_t(w) * channels;
+      for (uint32_t row = 0; row < h; ++row) {
+        const uint32_t srcRow = h - 1u - row;
+        std::fwrite(topDownData + size_t(srcRow) * rowFloats, sizeof(float), rowFloats, f);
+      }
+      std::fclose(f);
+      MoveFileExW(tmpPath.wstring().c_str(), finalPath.wstring().c_str(), MOVEFILE_REPLACE_EXISTING);
+    }
