+    }
+    Rc<DxvkImage> srcImage = rtOutput.m_finalOutput.resource(Resources::AccessType::Read).image;
+    if (srcImage == nullptr) {
+      return;
+    }
+    const VkExtent3D ext = srcImage->info().extent;
+    const VkDeviceSize byteSize = VkDeviceSize(ext.width) * ext.height * 8;
+    m_gateDump.preTonemapBuf = allocHostReadbackBuffer(m_device, byteSize, "Gate PreTonemap Readback");
+    m_gateDump.preTonemapExtent = ext;
+    m_gateDump.pendingTag = tag;
+    m_gateDump.lastTag = tag;
+
+    VkImageSubresourceLayers subres = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    copyImageToBuffer(m_gateDump.preTonemapBuf, 0, 8, 8, srcImage, subres, VkOffset3D { 0, 0, 0 }, ext);
+  }
+
+  void RtxContext::captureGateDumpPostTonemap(const Resources::RaytracingOutput& rtOutput) {
+    if (m_gateDump.pendingTag.empty() || m_gateDump.preTonemapBuf == nullptr) {
+      return;
+    }
+
+    erase_if(m_gateDump.asyncTasks, [](std::future<void>& f) {
+      return !f.valid() || f.wait_for(std::chrono::seconds(0)) == std::future_status::ready;
+    });
+
+    Rc<DxvkImage> postImg = rtOutput.m_finalOutput.resource(Resources::AccessType::Read).image;
+    Rc<DxvkImage> depthImg = rtOutput.m_primaryLinearViewZ.image;
+    if (postImg == nullptr || depthImg == nullptr) {
+      m_gateDump.pendingTag.clear();
+      m_gateDump.preTonemapBuf = nullptr;
+      return;
+    }
+
+    const VkExtent3D postExt = postImg->info().extent;
+    const VkExtent3D depthExt = depthImg->info().extent;
+    Rc<DxvkBuffer> postBuf = allocHostReadbackBuffer(m_device, VkDeviceSize(postExt.width) * postExt.height * 8, "Gate PostTonemap Readback");
+    Rc<DxvkBuffer> depthBuf = allocHostReadbackBuffer(m_device, VkDeviceSize(depthExt.width) * depthExt.height * 4, "Gate Depth Readback");
+
+    VkImageSubresourceLayers subres = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    copyImageToBuffer(postBuf, 0, 8, 8, postImg, subres, VkOffset3D { 0, 0, 0 }, postExt);
+    copyImageToBuffer(depthBuf, 0, 4, 4, depthImg, subres, VkOffset3D { 0, 0, 0 }, depthExt);
+
+    emitMemoryBarrier(0,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT,
+      VK_ACCESS_HOST_READ_BIT);
+
+    const uint64_t syncVal = ++m_gateDump.signalValue;
+    this->signal(m_gateDump.fence, syncVal);
+
+    NrdArgs primaryDirectNrd = {}, primaryIndirectNrd = {}, secondaryNrd = {};
+    getDenoiseArgs(primaryDirectNrd, primaryIndirectNrd, secondaryNrd);
+    const float missLinearViewZ = primaryDirectNrd.missLinearViewZ;
+    const bool cameraIsLhs = getSceneManager().getCamera().isLHS();
+    const bool tonemapActive =
+      m_common->metaDebugView().debugViewIdx() != DEBUG_VIEW_PRE_TONEMAP_OUTPUT &&
+      ((RtxOptions::tonemappingMode() == TonemappingMode::Global && m_common->metaToneMapping().tonemappingEnabled()) ||
+       m_common->metaLocalToneMapping().isActive());
+
+    std::string tag = std::move(m_gateDump.pendingTag);
+    m_gateDump.pendingTag.clear();
+    Rc<DxvkBuffer> preBuf = std::move(m_gateDump.preTonemapBuf);
+    Rc<sync::Fence> fence = m_gateDump.fence;
+    const std::filesystem::path gateDir = std::filesystem::path(env::getExePath()).parent_path() / "gate";
+
+    m_gateDump.asyncTasks.push_back(std::async(
+      std::launch::async,
+      [fence, syncVal, preBuf = std::move(preBuf), postBuf = std::move(postBuf), depthBuf = std::move(depthBuf),
+       postExt, depthExt, missLinearViewZ, cameraIsLhs, tonemapActive, tag = std::move(tag), gateDir]() {
+        fence->wait(syncVal);
+
+        const uint16_t* preHalf = reinterpret_cast<const uint16_t*>(preBuf->mapPtr(0));
+        const uint16_t* postHalf = reinterpret_cast<const uint16_t*>(postBuf->mapPtr(0));
+        const float* rawDepth = reinterpret_cast<const float*>(depthBuf->mapPtr(0));
+        if (preHalf != nullptr && postHalf != nullptr) {
+          const size_t numPixels = size_t(postExt.width) * postExt.height;
+          std::vector<float> rgb(numPixels * 3);
+          for (size_t i = 0; i < numPixels; ++i) {
+            const float pr = halfToFloat32(preHalf[i * 4 + 0]);
+            const float pg = halfToFloat32(preHalf[i * 4 + 1]);
+            const float pb = halfToFloat32(preHalf[i * 4 + 2]);
+            // Preserve any GPU NaN/Inf from before tonemap's saturate() clamp.
+            if (!std::isfinite(pr) || !std::isfinite(pg) || !std::isfinite(pb)) {
+              rgb[i * 3 + 0] = pr;
+              rgb[i * 3 + 1] = pg;
+              rgb[i * 3 + 2] = pb;
+            } else if (tonemapActive) {
+              rgb[i * 3 + 0] = halfToFloat32(postHalf[i * 4 + 0]);
+              rgb[i * 3 + 1] = halfToFloat32(postHalf[i * 4 + 1]);
+              rgb[i * 3 + 2] = halfToFloat32(postHalf[i * 4 + 2]);
+            } else {
+              rgb[i * 3 + 0] = pr;
+              rgb[i * 3 + 1] = pg;
+              rgb[i * 3 + 2] = pb;
+            }
+          }
+          writePfmAtomic(gateDir / (tag + "_final.pfm"), postExt.width, postExt.height, 3, rgb.data());
+        }
+
+        if (rawDepth != nullptr) {
+          const size_t numDepth = size_t(depthExt.width) * depthExt.height;
+          std::vector<float> linearDepth(numDepth);
+          for (size_t i = 0; i < numDepth; ++i) {
+            const float z = rawDepth[i];
+            if (!std::isfinite(z) || z == missLinearViewZ) {
+              linearDepth[i] = INFINITY;
+            } else {
+              const float dist = cameraIsLhs ? z : -z;
+              linearDepth[i] = (dist > 0.0f) ? dist : INFINITY;
+            }
+          }
+          writePfmAtomic(gateDir / (tag + "_depth.pfm"), depthExt.width, depthExt.height, 1, linearDepth.data());
+        }
+      }));
+  }
+
+  void RtxContext::captureGateTelemetry(const Rc<DxvkImage>& finalImg, bool rayTraced) {
+    if (!RtxOptions::writeFrameTelemetry() || finalImg == nullptr) {
+      return;
+    }
+    // The thumbnail is made with a filtered blit, which Vulkan does not allow from multisampled or integer images.
+    if (finalImg->info().sampleCount != VK_SAMPLE_COUNT_1_BIT
+        || imageFormatInfo(finalImg->info().format)->flags.any(DxvkFormatFlag::SampledUInt, DxvkFormatFlag::SampledSInt)) {
+      return;
+    }
+    // The recorder times its own GPU work as the "Gate Telemetry" step and its CPU work as telemetryCpuMs.
+    ScopedGpuProfileZone(this, "Gate Telemetry");
+    const auto cpuStart = std::chrono::steady_clock::now();
+
+    if (m_gateTelemetry.gpuCounters == nullptr) {
+      auto makeThumbImage = [&](uint32_t w, uint32_t h, const char* name) {
+        DxvkImageCreateInfo desc = {};
+        desc.type = VK_IMAGE_TYPE_2D;
+        desc.format = VK_FORMAT_R16G16B16A16_SFLOAT;
+        desc.flags = 0;
+        desc.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+        desc.extent = VkExtent3D { w, h, 1 };
+        desc.numLayers = 1;
+        desc.mipLevels = 1;
+        desc.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+        desc.stages = VK_PIPELINE_STAGE_TRANSFER_BIT;
+        desc.access = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT;
+        desc.tiling = VK_IMAGE_TILING_OPTIMAL;
+        desc.layout = VK_IMAGE_LAYOUT_UNDEFINED;
+        return m_device->createImage(desc, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, DxvkMemoryStats::Category::RTXRenderTarget, name);
+      };
+      m_gateTelemetry.thumbMid = makeThumbImage(kGateMidW, kGateMidH, "Gate Thumb 512x288");
+      m_gateTelemetry.thumbSmall = makeThumbImage(kGateThumbW, kGateThumbH, "Gate Thumb 128x72");
+
+      DxvkBufferCreateInfo cInfo = {};
+      cInfo.size = kGateTelemetrySlots * sizeof(uint32_t);
+      cInfo.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+      cInfo.stages = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+      cInfo.access = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT;
+      m_gateTelemetry.gpuCounters = m_device->createBuffer(cInfo, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, DxvkMemoryStats::Category::RTXBuffer, "Gate Skinned Counters");
+
+      for (uint32_t s = 0; s < kGateTelemetrySlots; ++s) {
+        m_gateTelemetry.readbackSlots[s] = allocHostReadbackBuffer(m_device, kGateCounterHeaderBytes + kGateThumbBytes, "Gate Telemetry Slot");
+      }
+    }
+
+    const uint32_t slot = m_gateTelemetry.nextSlot++ % kGateTelemetrySlots;
+    if (m_gateTelemetry.slotSync[slot] != 0) {
+      m_gateTelemetry.fence->wait(m_gateTelemetry.slotSync[slot]);
+    }
+
+    clearBuffer(m_gateTelemetry.gpuCounters, VkDeviceSize(slot) * sizeof(uint32_t), sizeof(uint32_t), 0u);
+    emitMemoryBarrier(0,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+
+    const uint32_t frameId = m_device->getCurrentFrameId();
+    bool dispatchedAny = false;
+    for (const RtInstance* instance : getSceneManager().getInstanceManager().getInstanceTable()) {
+      if (instance == nullptr || instance->isMarkedForGC() || instance->getFrameLastUpdated() != frameId || instance->isHidden()) {
+        continue;
+      }
+      const BlasEntry* blas = instance->getBlas();
+      if (blas == nullptr || !(blas->input.usesVertexShaderSkinning || blas->input.getSkinningState().numBones > 0)) {
+        continue;
+      }
+      if (blas->input.getGeometryData().cullMode == VK_CULL_MODE_NONE) {
+        continue;
+      }
+      const RaytraceGeometry& geo = blas->modifiedGeometryData;
+      const uint32_t numTris = (geo.indexCount > 0) ? (geo.indexCount / 3) : (geo.vertexCount / 3);
+      if (numTris == 0 || !geo.positionBuffer.defined() || !geo.normalBuffer.defined()) {
+        continue;
+      }
+      if (!dispatchedAny) {
+        setPushConstantBank(DxvkPushConstantBank::RTX);
+        bindShader(VK_SHADER_STAGE_COMPUTE_BIT, GateSkinnedTrianglesShader::getShader());
+        bindResourceBuffer(GATE_SKINNED_TRIANGLES_BINDING_COUNTERS_RW, DxvkBufferSlice(m_gateTelemetry.gpuCounters));
+        dispatchedAny = true;
+      }
+
+      bindResourceBuffer(GATE_SKINNED_TRIANGLES_BINDING_POSITION_RO, geo.positionBuffer);
+      bindResourceBuffer(GATE_SKINNED_TRIANGLES_BINDING_NORMAL_RO, geo.normalBuffer);
+      bindResourceBuffer(GATE_SKINNED_TRIANGLES_BINDING_INDEX_RO,
+        geo.indexBuffer.defined() ? static_cast<const DxvkBufferSlice&>(geo.indexBuffer)
+                                  : static_cast<const DxvkBufferSlice&>(geo.positionBuffer));
+
+      const bool flipWinding = (instance->getVkInstance().flags & VK_GEOMETRY_INSTANCE_TRIANGLE_FLIP_FACING_BIT_KHR) != 0;
+      GateSkinnedTrianglesArgs args = {};
+      args.positionOffset = uint32_t(geo.positionBuffer.offsetFromSlice());
+      args.positionStride = uint32_t(geo.positionBuffer.stride());
+      args.normalOffset = uint32_t(geo.normalBuffer.offsetFromSlice());
+      args.normalStride = uint32_t(geo.normalBuffer.stride());
+      args.indexOffset = geo.indexBuffer.defined() ? uint32_t(geo.indexBuffer.offsetFromSlice()) : 0u;
+      args.numTriangles = numTris;
+      args.flags =
+        (geo.indexBuffer.defined() ? GATE_SKINNED_FLAG_INDEXED : 0u) |
+        ((geo.indexBuffer.defined() && geo.indexBuffer.indexType() == VK_INDEX_TYPE_UINT16) ? GATE_SKINNED_FLAG_SHORT_INDICES : 0u) |
+        ((geo.normalBuffer.vertexFormat() == VK_FORMAT_R32_UINT) ? GATE_SKINNED_FLAG_NORMALS_ENCODED : 0u) |
+        (flipWinding ? GATE_SKINNED_FLAG_FLIP_WINDING : 0u);
+      args.counterSlot = slot;
+      args.objToWorld0 = instance->surface.objectToWorld.data[0];
+      args.objToWorld1 = instance->surface.objectToWorld.data[1];
+      args.objToWorld2 = instance->surface.objectToWorld.data[2];
+      args.normToWorld0 = Vector4(instance->surface.normalObjectToWorld.data[0], 0.0f);
+      args.normToWorld1 = Vector4(instance->surface.normalObjectToWorld.data[1], 0.0f);
+      args.normToWorld2 = Vector4(instance->surface.normalObjectToWorld.data[2], 0.0f);
+
+      pushConstants(0, sizeof(args), &args);
+      const VkExtent3D wg = util::computeBlockCount(VkExtent3D { numTris, 1, 1 }, VkExtent3D { 128, 1, 1 });
+      dispatch(wg.width, wg.height, wg.depth);
+    }
+
+    if (dispatchedAny) {
+      unbindComputePipeline();
+      emitMemoryBarrier(0,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_ACCESS_SHADER_WRITE_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_ACCESS_TRANSFER_READ_BIT);
+    }
+
+    Rc<DxvkBuffer> dstSlot = m_gateTelemetry.readbackSlots[slot];
+    copyBuffer(dstSlot, 0, m_gateTelemetry.gpuCounters, VkDeviceSize(slot) * sizeof(uint32_t), sizeof(uint32_t));
+
+    changeImageLayout(m_gateTelemetry.thumbMid, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    blitImageHelper(this, finalImg, m_gateTelemetry.thumbMid, VK_FILTER_LINEAR);
+    changeImageLayout(m_gateTelemetry.thumbMid, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    changeImageLayout(m_gateTelemetry.thumbSmall, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    blitImageHelper(this, m_gateTelemetry.thumbMid, m_gateTelemetry.thumbSmall, VK_FILTER_LINEAR);
+    changeImageLayout(m_gateTelemetry.thumbSmall, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+
+    VkImageSubresourceLayers subres = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    copyImageToBuffer(dstSlot, kGateCounterHeaderBytes, 8, 8, m_gateTelemetry.thumbSmall, subres,
+      VkOffset3D { 0, 0, 0 }, VkExtent3D { kGateThumbW, kGateThumbH, 1 });
+
+    emitMemoryBarrier(0,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT,
+      VK_ACCESS_HOST_READ_BIT);
+
+    const uint64_t syncVal = ++m_gateTelemetry.signalValue;
+    m_gateTelemetry.slotSync[slot] = syncVal;
+    this->signal(m_gateTelemetry.fence, syncVal);
+
+    const bool tonemapActive =
+      m_common->metaDebugView().debugViewIdx() != DEBUG_VIEW_PRE_TONEMAP_OUTPUT &&
+      ((RtxOptions::tonemappingMode() == TonemappingMode::Global && m_common->metaToneMapping().tonemappingEnabled()) ||
+       m_common->metaLocalToneMapping().isActive());
+    float lumaScale = 1.0f;
+    if (rayTraced && !tonemapActive && RtxOptions::tonemappingMode() == TonemappingMode::Global) {
+      const float ev = m_common->metaToneMapping().exposureBias() + RtxOptions::calcUserEVBias();
+      if (ev < 0.0f) {
+        lumaScale = std::exp2(-ev / 2.2f);
+      }
+    }
+
+    Rc<sync::Fence> fence = m_gateTelemetry.fence;
+    getSceneManager().setTelemetryResolve([fence, syncVal, dstSlot, lumaScale](RtxFrameTelemetry& out) {
+      fence->wait(syncVal);
+      const uint8_t* raw = reinterpret_cast<const uint8_t*>(dstSlot->mapPtr(0));
+      if (raw == nullptr) {
+        return;
+      }
+      uint32_t inward = 0;
+      std::memcpy(&inward, raw, sizeof(uint32_t));
+      out.inwardSkinnedTriangles = inward;
+
+      const uint16_t* px = reinterpret_cast<const uint16_t*>(raw + kGateCounterHeaderBytes);
+      uint8_t luma[kGateThumbW * kGateThumbH];
+      float rgbSum[(kGateThumbW / 2) * (kGateThumbH / 2) * 3] = {};   // each cell sums a 2x2 block
+      for (size_t i = 0; i < kGateThumbW * kGateThumbH; ++i) {
+        float r = halfToFloat32(px[i * 4 + 0]) * lumaScale;
+        float g = halfToFloat32(px[i * 4 + 1]) * lumaScale;
+        float b = halfToFloat32(px[i * 4 + 2]) * lumaScale;
+        if (!std::isfinite(r) || !std::isfinite(g) || !std::isfinite(b)) {
+          ++out.thumbNonFinite;
+        } else if (r >= 1.0f && g >= 1.0f && b >= 1.0f) {
+          ++out.thumbClipped;
+        }
+        r = std::isfinite(r) ? std::clamp(r, 0.0f, 1.0f) : 0.0f;
+        g = std::isfinite(g) ? std::clamp(g, 0.0f, 1.0f) : 0.0f;
+        b = std::isfinite(b) ? std::clamp(b, 0.0f, 1.0f) : 0.0f;
+        const float y = 0.2126f * r + 0.7152f * g + 0.0722f * b;
+        luma[i] = static_cast<uint8_t>(std::clamp(y * 255.0f + 0.5f, 0.0f, 255.0f));
+        float* cell = &rgbSum[((i / kGateThumbW / 2) * (kGateThumbW / 2) + (i % kGateThumbW) / 2) * 3];
+        cell[0] += r;
+        cell[1] += g;
+        cell[2] += b;
+      }
+      out.lumaThumb = encodeBase64(luma, sizeof(luma));
+      uint8_t rgb[sizeof(rgbSum) / sizeof(float)];
+      for (size_t i = 0; i < sizeof(rgb); ++i) {
+        rgb[i] = static_cast<uint8_t>(rgbSum[i] * (255.0f / 4.0f) + 0.5f);
+      }
+      out.rgbThumb = encodeBase64(rgb, sizeof(rgb));
+    });
+    getSceneManager().addTelemetryCpuMs(std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - cpuStart).count());
+  }
 } // namespace dxvk
