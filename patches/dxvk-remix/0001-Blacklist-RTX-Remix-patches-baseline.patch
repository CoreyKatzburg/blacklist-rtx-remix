+// NV-DXVK start: per-frame telemetry
+//
+// Writes one JSON object per rendered frame to a JSON Lines file (rtx_telemetry.jsonl next to the
+// game exe). Automated tests read it to check performance and scene behaviour without screenshots.
+// The file is truncated when the writer opens it (once per launch). The render thread pushes each
+// frame record (plus an optional GPU-readback resolver) onto a queue; a background thread resolves
+// any GPU readback, formats the JSON line, and writes it to disk.
+//
+// Field contract (do not rename; new fields may be added):
+//   frame                   frame index (uint)
+//   frameTimeMs             CPU time between this frame's end and the previous one
+//   gpuTimeMs               GPU busy time in the same interval (interval minus measured GPU idle time)
+//   instances               active ray-traced instances
+//   skinnedInstances        active instances of skinned (character) meshes drawn this frame
+//   staticBlasRebuilds      existing non-skinned meshes whose geometry was marked changed this frame
+//   cameraCut               true when Remix treated this frame as a camera cut (scene flush)
+//   textureMemoryMB         device-local memory used by game and replacement textures
+//   vramUsedMB              device-local memory used by this process (VK_EXT_memory_budget)
+//   skinnedTriangles        triangles of skinned instances drawn this frame
+//   inwardSkinnedTriangles  skinned triangles whose winding face normal opposes their vertex normals
+//   rayTraced               true when Remix ray traced this frame, false on goggle and menu frames
+//   passMs                  {"Parent/Step":[gpuMs, cpuMs, count]} for every labelled render step
+//                           (ScopedGpuProfileZone) that closed this frame. gpuMs is -1 when the GPU result
+//                           did not arrive within 0.5 s. A parent's time includes its children.
+//   telemetryCpuMs          render-thread CPU time this recorder itself used this frame
+//   skips                   {"reason":count} draws the D3D9 layer kept out of ray tracing (see RtxSkip).
+//                           Counted on the game's draw thread, so a count can land one frame late.
+//   replacedMaterialDraws   draws whose texture has a replacement material in the mod
+//   legacyMaterialDraws     draws that fell back to the game's plain texture
+//   newLegacyMaterials      hex texture hashes first seen falling back this frame (at most 64 per frame)
+//   texturesDemoted         replacement textures forced to their smallest size by the VRAM budget
+//   textureBudgetMB         VRAM budget for replacement textures (0 until Remix first computes it)
+//   thumbNonFinite          thumbnail pixels holding NaN or infinity before clamping
+//   thumbClipped            thumbnail pixels at or above full white in all three channels
+//   rgbThumb                optional base64 of 64x36 8-bit RGB from the same image as lumaThumb
+//   lumaThumb               optional base64 of 128x72 8-bit Rec.709 luma. Remix's final image on ray-traced
+//                           frames, the game's own picture on frames with rayTraced false.
+
+namespace dxvk {
+
+  // Why the D3D9 layer kept a draw out of ray tracing. kRtxSkipNames holds the JSON key of each reason.
