+*/
+#pragma once
+
+#include "rtx/utility/shader_types.h"
+
+#define GATE_SKINNED_TRIANGLES_BINDING_POSITION_RO 0
+#define GATE_SKINNED_TRIANGLES_BINDING_NORMAL_RO   1
+#define GATE_SKINNED_TRIANGLES_BINDING_INDEX_RO    2
+#define GATE_SKINNED_TRIANGLES_BINDING_COUNTERS_RW 3
+
+#define GATE_SKINNED_FLAG_INDEXED         (1u << 0)
+#define GATE_SKINNED_FLAG_SHORT_INDICES   (1u << 1)
+#define GATE_SKINNED_FLAG_NORMALS_ENCODED (1u << 2)
+#define GATE_SKINNED_FLAG_FLIP_WINDING    (1u << 3)
+
+struct GateSkinnedTrianglesArgs {
+  uint positionOffset;
+  uint positionStride;
+  uint normalOffset;
+  uint normalStride;
+  uint indexOffset;
+  uint numTriangles;
+  uint flags;
+  uint counterSlot;
+  vec4 objToWorld0;
+  vec4 objToWorld1;
+  vec4 objToWorld2;
+  vec4 normToWorld0;
+  vec4 normToWorld1;
+  vec4 normToWorld2;
+};
