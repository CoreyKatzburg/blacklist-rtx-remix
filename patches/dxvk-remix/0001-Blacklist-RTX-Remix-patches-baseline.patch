diff --git a/bridge/src/util/util_shared_status.h b/bridge/src/util/util_shared_status.h
new file mode 100644
index 0000000..c378bbf
--- /dev/null
+++ b/bridge/src/util/util_shared_status.h
@@ -0,0 +1,79 @@
+#pragma once
+
+#include "util_sharedmemory.h"
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <d3d9.h>
+
+namespace bridge_fast_status {
+
+static constexpr uint32_t kOcclusionSlotCount = 4096;
+
+struct alignas(16) OcclusionSlot {
+  std::atomic<uint32_t> handle;
+  std::atomic<uint32_t> lastPixels;
+  std::atomic<uint32_t> completedSeq;
+  uint32_t reserved;
+};
+
+struct alignas(64) SharedStatusBlock {
+  std::atomic<uint32_t> statusValid;
+  std::atomic<uint32_t> availableTextureMem;
+  std::atomic<int32_t> deviceState;
+  std::atomic<uint32_t> displayValid;
+  std::atomic<uint32_t> displayWidth;
+  std::atomic<uint32_t> displayHeight;
+  std::atomic<uint32_t> displayRefreshRate;
+  std::atomic<uint32_t> displayFormat;
+  std::atomic<uint32_t> displayScanLineOrdering;
+  std::atomic<uint32_t> displayRotation;
+  uint32_t pad[6];
+  OcclusionSlot occlusion[kOcclusionSlotCount];
+};
+
+inline SharedStatusBlock* getBlock() {
+  static bridge_util::SharedMemory s_shm("NvRemixBridgeFastStatus", sizeof(SharedStatusBlock));
+  return reinterpret_cast<SharedStatusBlock*>(s_shm.data());
+}
+
+inline OcclusionSlot* findOrClaimOcclusionSlot(uint32_t handle, bool claim) {
+  if (handle == 0) {
+    return nullptr;
+  }
+  SharedStatusBlock* block = getBlock();
+  if (!block) {
+    return nullptr;
+  }
+  const uint32_t start = (handle * 2654435761u) & (kOcclusionSlotCount - 1);
+  for (uint32_t probe = 0; probe < 64; ++probe) {
+    OcclusionSlot& slot = block->occlusion[(start + probe) & (kOcclusionSlotCount - 1)];
+    uint32_t cur = slot.handle.load(std::memory_order_acquire);
+    if (cur == handle) {
+      return &slot;
+    }
+    if (claim && cur == 0) {
+      uint32_t expected = 0;
+      if (slot.handle.compare_exchange_strong(expected, handle, std::memory_order_acq_rel)) {
+        slot.lastPixels.store(0, std::memory_order_relaxed);
+        slot.completedSeq.store(0, std::memory_order_release);
+        return &slot;
+      }
+      if (expected == handle) {
+        return &slot;
+      }
+    }
+  }
+  return nullptr;
+}
+
+inline void releaseOcclusionSlot(uint32_t handle) {
+  if (OcclusionSlot* slot = findOrClaimOcclusionSlot(handle, false)) {
+    slot->lastPixels.store(0, std::memory_order_relaxed);
+    slot->completedSeq.store(0, std::memory_order_relaxed);
+    slot->handle.store(0, std::memory_order_release);
+  }
+}
+
+} // namespace bridge_fast_status
