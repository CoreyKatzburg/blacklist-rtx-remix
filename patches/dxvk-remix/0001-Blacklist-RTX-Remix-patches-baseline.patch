diff --git a/src/dxso/dxso_capture_analysis.cpp b/src/dxso/dxso_capture_analysis.cpp
new file mode 100644
index 0000000..bd72253
--- /dev/null
+++ b/src/dxso/dxso_capture_analysis.cpp
@@ -0,0 +1,652 @@
+#include "dxso_capture_analysis.h"
+
+#include <algorithm>
+#include <array>
+#include <bitset>
+#include <cstring>
+#include <iterator>
+#include <string>
+
+// NV-DXVK start: vertex capture analysis
+namespace dxvk {
+
+  namespace {
+
+    // Register types (D3DSHADER_PARAM_REGISTER_TYPE).
+    namespace reg {
+      constexpr uint32_t Temp = 0, Input = 1, Const = 2, Addr = 3, Output = 6, ConstInt = 7,
+                         Sampler = 10, ConstBool = 14, Loop = 15, Predicate = 19;
+    }
+
+    // Opcodes (D3DSHADER_INSTRUCTION_OPCODE_TYPE).
+    namespace op {
+      constexpr uint32_t Nop = 0, Mov = 1, Add = 2, Sub = 3, Mad = 4, Mul = 5, Rcp = 6, Rsq = 7, Dp3 = 8,
+                         Dp4 = 9, Min = 10, Max = 11, Slt = 12, Sge = 13, Exp = 14, Log = 15, Lrp = 18,
+                         Frc = 19, M4x4 = 20, M4x3 = 21, M3x4 = 22, M3x3 = 23, M3x2 = 24, Call = 25,
+                         CallNz = 26, Loop = 27, Ret = 28, EndLoop = 29, Label = 30, Dcl = 31, Pow = 32,
+                         Crs = 33, Sgn = 34, Abs = 35, Nrm = 36, SinCos = 37, Rep = 38, EndRep = 39,
+                         If = 40, Ifc = 41, Else = 42, EndIf = 43, Break = 44, BreakC = 45, Mova = 46,
+                         DefB = 47, DefI = 48, ExpP = 78, LogP = 79, Cnd = 80, Def = 81, Cmp = 88,
+                         Dp2Add = 90, SetP = 94, BreakP = 96, Comment = 0xFFFE, End = 0xFFFF;
+    }
+
+    constexpr uint32_t kUsagePosition = 0, kUsageBlendWeight = 1, kUsageBlendIndices = 2, kUsageNormal = 3;
+
+    constexpr uint32_t kMaxInputs = 16;
+    constexpr uint32_t kMaxFloatConsts = 256;
+    constexpr uint32_t kMaxTemps = 32;
+    constexpr uint32_t kMaxOutputs = 16;
+
+    // A "source" is an input register or a float constant register a value can come from.
+    using Sources = std::bitset<kMaxInputs + kMaxFloatConsts>;
+    inline size_t inputBit(uint32_t v) { return v; }
+    inline size_t constBit(uint32_t c) { return kMaxInputs + c; }
+
+    // Splinter Cell Blacklist names for constants that only map world space to the screen
+    // (camera and viewport). Captured positions are converted back to world space with the
+    // camera, so these never change the captured geometry. Evidence: tests/remix_source.
+    //   gWorldToProj c8-c11: object x view x projection, or camera-relative view x projection
+    //   gViewportOffset c1, gViewportSB c2: viewport offset / scale-bias
+    //   cViewPos_VS c13: camera position (skinned shaders subtract it before projecting)
+    //   cProjSkinMesh c14: clip-space offset added after projection in skinned shaders
+    constexpr const char* kCameraOnlyConstants[] = {
+      "gWorldToProj", "gViewportOffset", "gViewportSB", "cViewPos_VS", "cProjSkinMesh"
+    };
+    // Constants that carry the object's own motion. Without one of them, the object transform
+    // lives only inside gWorldToProj, so camera constants must stay in the hash.
+    constexpr const char* kObjectMotionConstants[] = { "gLocalToWorld", "gBones" };
+    // Non-skinned vertex animation constants (foliage wind sway and water waves) that deform
+    // vertex positions every frame even while the camera and object transform stand still.
+    constexpr const char* kVertexAnimationConstants[] = {
+      "gWindAnimInfo1", "gWindAnimInfo2", "gWindAnimFreq",
+      "cWaveHeights", "cWaveLengths", "cWaveSpeeds", "cWaveDir0", "cWaveDir1", "cWaveCresting", "cMiscParams"
+    };
+
+    struct Param {
+      uint32_t type = 0;
+      uint32_t num = 0;
+      uint32_t bits = 0;       // write mask (dst) or swizzle (src)
+      bool relative = false;
+      uint32_t relType = 0, relNum = 0, relComp = 0;
+    };
+
+    struct Instr {
+      uint32_t op = 0;
+      bool hasDst = false;
+      bool predicated = false;
+      Param dst;
+      Param pred;
+      std::vector<Param> srcs;
+    };
+
+    struct CtabEntry {
+      std::string name;
+      uint16_t set = 0, first = 0, count = 0;
+    };
+
+    struct State {
+      std::array<Sources, kMaxTemps * 4> temps;
+      std::array<Sources, kMaxOutputs * 4> outputs;
+      std::array<Sources, 4> addr;
+      std::array<Sources, 4> pred;
+      Sources loopCounter;
+
+      bool operator==(const State& o) const {
+        return temps == o.temps && outputs == o.outputs && addr == o.addr && pred == o.pred && loopCounter == o.loopCounter;
+      }
+      bool operator!=(const State& o) const { return !(*this == o); }
+    };
+
+    inline uint32_t regType(uint32_t tok) { return ((tok >> 28) & 0x7) | ((tok >> 8) & 0x18); }
+    inline uint32_t swizzleComp(uint32_t swizzle, uint32_t c) { return (swizzle >> (2 * c)) & 0x3; }
+
+    bool hasDestination(uint32_t opcode) {
+      switch (opcode) {
+      case op::Call: case op::CallNz: case op::Loop: case op::Ret: case op::EndLoop: case op::Label:
+      case op::Rep: case op::EndRep: case op::If: case op::Ifc: case op::Else: case op::EndIf:
+      case op::Break: case op::BreakC: case op::BreakP: case op::Nop:
+        return false;
+      default:
+        return true;
+      }
+    }
+
+    class Analyzer {
+    public:
+      Analyzer(const uint32_t* tokens, size_t count) : m_tokens(tokens), m_count(count) { }
+
+      DxsoCaptureAnalysis run() {
+        DxsoCaptureAnalysis result;
+        if (!parse()) {
+          return result;
+        }
+        matchControlFlow();
+        if (!m_ok) {
+          return result;
+        }
+
+        State state;
+        execute(0, m_code.size(), state, Sources(), false);
+        if (!m_ok) {
+          return result;
+        }
+
+        result.valid = true;
+        findNormalOutput(state, result);
+        findGeometryConstants(state, result);
+        return result;
+      }
+
+    private:
+      const uint32_t* m_tokens;
+      size_t m_count;
+      bool m_ok = true;
+
+      std::vector<Instr> m_code;
+      std::vector<size_t> m_partner;   // if -> else/endif, else -> endif, loop/rep -> end
+      std::vector<CtabEntry> m_ctab;
+      std::bitset<kMaxFloatConsts> m_defined;
+      std::array<std::array<float, 4>, kMaxFloatConsts> m_defValues {};
+      std::array<int, kMaxInputs> m_inputUsage {};     // packed usage | index << 8, -1 if undeclared
+      std::array<int, kMaxOutputs> m_outputUsage {};
+      std::array<uint32_t, kMaxOutputs> m_outputMask {};
+      Sources m_breakConditions;
+
+      void parseCtab(size_t first, size_t length) {
+        if (length < 8 || m_tokens[first] != 0x42415443u) { // 'CTAB'
+          return;
+        }
+        const uint8_t* base = reinterpret_cast<const uint8_t*>(m_tokens + first + 1);
+        const size_t size = (length - 1) * 4;
+        uint32_t constantCount, constantInfo;
+        std::memcpy(&constantCount, base + 12, 4);
+        std::memcpy(&constantInfo, base + 16, 4);
+        for (uint32_t k = 0; k < constantCount; k++) {
+          const size_t entry = size_t(constantInfo) + size_t(k) * 20;
+          if (entry + 20 > size) {
+            return;
+          }
+          uint32_t nameOffset;
+          CtabEntry e;
+          std::memcpy(&nameOffset, base + entry, 4);
+          std::memcpy(&e.set, base + entry + 4, 2);
+          std::memcpy(&e.first, base + entry + 6, 2);
+          std::memcpy(&e.count, base + entry + 8, 2);
+          if (nameOffset >= size) {
+            continue;
+          }
+          const char* name = reinterpret_cast<const char*>(base + nameOffset);
+          e.name.assign(name, strnlen(name, size - nameOffset));
+          m_ctab.push_back(std::move(e));
+        }
+      }
+
+      bool readParam(size_t& i, size_t end, bool isDst, Param& p) {
+        if (i >= end) {
+          return false;
+        }
+        const uint32_t tok = m_tokens[i++];
+        p.type = regType(tok);
+        p.num = tok & 0x7FF;
+        p.bits = isDst ? (tok >> 16) & 0xF : (tok >> 16) & 0xFF;
+        p.relative = (tok & (1u << 13)) != 0;
+        if (p.relative) {
+          if (i >= end) {
+            return false;
+          }
+          const uint32_t rel = m_tokens[i++];
+          p.relType = regType(rel);
+          p.relNum = rel & 0x7FF;
+          p.relComp = (rel >> 16) & 0x3;
+        }
+        return true;
+      }
+
+      bool parse() {
+        if (m_count < 2 || m_tokens[0] != 0xFFFE0300u) { // vs_3_0 only
+          return false;
+        }
+        m_inputUsage.fill(-1);
+        m_outputUsage.fill(-1);
+
+        size_t i = 1;
+        while (i < m_count) {
+          const uint32_t tok = m_tokens[i];
+          const uint32_t opcode = tok & 0xFFFF;
+          if (opcode == op::End) {
+            return true;
+          }
+          if (opcode == op::Comment) {
+            const size_t length = (tok >> 16) & 0x7FFF;
+            if (i + 1 + length > m_count) {
+              return false;
+            }
+            parseCtab(i + 1, length);
+            i += 1 + length;
+            continue;
+          }
+          const size_t length = (tok >> 24) & 0xF;
+          const size_t begin = i + 1, end = begin + length;
+          if (end > m_count) {
+            return false;
+          }
+          i = end;
+
+          if (opcode == op::Dcl) {
+            if (length != 2) {
+              continue;
+            }
+            const uint32_t usage = m_tokens[begin] & 0x1F;
+            const uint32_t index = (m_tokens[begin] >> 16) & 0xF;
+            const uint32_t dst = m_tokens[begin + 1];
+            const uint32_t type = regType(dst), num = dst & 0x7FF;
+            if (type == reg::Input && num < kMaxInputs) {
+              m_inputUsage[num] = int(usage | (index << 8));
+            } else if (type == reg::Output && num < kMaxOutputs) {
+              m_outputUsage[num] = int(usage | (index << 8));
+              m_outputMask[num] = (dst >> 16) & 0xF;
+            }
+            continue;
+          }
+          if (opcode == op::Def) {
+            const uint32_t num = m_tokens[begin] & 0x7FF;
+            if (num < kMaxFloatConsts && length >= 5) {
+              m_defined.set(num);
+              for (uint32_t k = 0; k < 4; k++) {
+                std::memcpy(&m_defValues[num][k], &m_tokens[begin + 1 + k], sizeof(float));
+              }
+            }
+            continue;
+          }
+          if (opcode == op::DefB || opcode == op::DefI) {
+            continue;
+          }
+
+          Instr ins;
+          ins.op = opcode;
+          ins.predicated = (tok & (1u << 28)) != 0;
+          size_t p = begin;
+          if (hasDestination(opcode)) {
+            ins.hasDst = true;
+            if (!readParam(p, end, true, ins.dst)) {
+              return false;
+            }
+          }
+          if (ins.predicated && !readParam(p, end, false, ins.pred)) {
+            return false;
+          }
+          while (p < end) {
+            Param src;
+            if (!readParam(p, end, false, src)) {
+              return false;
+            }
+            ins.srcs.push_back(src);
+          }
+          m_code.push_back(std::move(ins));
+        }
+        return false; // no END token
+      }
+
+      void matchControlFlow() {
+        m_partner.assign(m_code.size(), SIZE_MAX);
+        std::vector<size_t> stack;
+        for (size_t i = 0; i < m_code.size(); i++) {
+          switch (m_code[i].op) {
+          case op::If: case op::Ifc: case op::Loop: case op::Rep:
+            stack.push_back(i);
+            break;
+          case op::Else:
+            if (stack.empty()) { m_ok = false; return; }
+            m_partner[stack.back()] = i;
+            stack.back() = i;
+            break;
+          case op::EndIf: case op::EndLoop: case op::EndRep:
+            if (stack.empty()) { m_ok = false; return; }
+            m_partner[stack.back()] = i;
+            stack.pop_back();
+            break;
+          case op::Call: case op::CallNz: case op::Label:
+            m_ok = false; // subroutines are not analysed
+            return;
+          default:
+            break;
+          }
+        }
+        m_ok = stack.empty();
+      }
+
+      const CtabEntry* floatEntryContaining(uint32_t c) const {
+        for (const auto& e : m_ctab) {
+          if (e.set == 2 && c >= e.first && c < uint32_t(e.first) + e.count) {
+            return &e;
+          }
+        }
+        return nullptr;
+      }
+
+      Sources readComponent(const State& s, const Param& p, uint32_t comp) {
+        const uint32_t c = swizzleComp(p.bits, comp);
+        Sources t;
+        switch (p.type) {
+        case reg::Temp:
+          if (p.num < kMaxTemps) t = s.temps[p.num * 4 + c]; else m_ok = false;
+          break;
+        case reg::Input:
+          if (p.num < kMaxInputs) t.set(inputBit(p.num)); else m_ok = false;
+          break;
+        case reg::Const:
+          if (p.relative) {
+            // Indexed read (e.g. bone palettes): any register of the indexed array.
+            const CtabEntry* e = floatEntryContaining(p.num);
+            const uint32_t first = e ? e->first : p.num;
+            const uint32_t last = e ? uint32_t(e->first) + e->count : kMaxFloatConsts;
+            for (uint32_t r = first; r < last && r < kMaxFloatConsts; r++) t.set(constBit(r));
+            if (p.relType == reg::Addr) t |= s.addr[p.relComp];
+            else if (p.relType == reg::Loop) t |= s.loopCounter;
+          } else if (p.num < kMaxFloatConsts) {
+            if (!m_defined.test(p.num)) t.set(constBit(p.num)); // literals are part of the bytecode
+          } else {
+            m_ok = false;
+          }
+          break;
+        case reg::Addr:
+          t = s.addr[c];
+          break;
+        case reg::Predicate:
+          t = s.pred[c];
+          break;
+        case reg::Loop:
+          t = s.loopCounter;
+          break;
+        case reg::ConstInt: case reg::ConstBool: case reg::Sampler:
+          break; // integer/bool constants are always hashed; samplers carry no data here
+        default:
+          m_ok = false;
+          break;
+        }
+        return t;
+      }
+
+      Sources readComponents(const State& s, const Param& p, uint32_t count) {
+        Sources t;
+        for (uint32_t c = 0; c < count; c++) t |= readComponent(s, p, c);
+        return t;
+      }
+
+      Sources* destination(State& s, const Param& p, uint32_t c) {
+        if (p.relative) {
+          m_ok = false;
+          return nullptr;
+        }
+        switch (p.type) {
+        case reg::Temp:      return p.num < kMaxTemps ? &s.temps[p.num * 4 + c] : nullptr;
+        case reg::Output:    return p.num < kMaxOutputs ? &s.outputs[p.num * 4 + c] : nullptr;
+        case reg::Addr:      return &s.addr[c];
+        case reg::Predicate: return &s.pred[c];
+        default:             return nullptr;
+        }
+      }
+
+      // Sources of destination component `c` for one arithmetic instruction.
+      Sources componentSources(const State& s, const Instr& ins, uint32_t c) {
+        Sources t;
+        auto all = [&](uint32_t comps) { for (const auto& src : ins.srcs) t |= readComponents(s, src, comps); };
+        switch (ins.op) {
+        case op::Mov: case op::Add: case op::Sub: case op::Mad: case op::Mul: case op::Min: case op::Max:
+        case op::Slt: case op::Sge: case op::Lrp: case op::Frc: case op::Abs: case op::Sgn: case op::Cmp:
+        case op::Cnd: case op::Mova: case op::SetP:
+          for (const auto& src : ins.srcs) t |= readComponent(s, src, c);
+          break;
+        case op::Dp3: case op::Nrm: case op::Crs:
+          all(3);
+          break;
+        case op::Dp4:
+          all(4);
+          break;
+        case op::Dp2Add:
+          if (ins.srcs.size() == 3) {
+            t |= readComponents(s, ins.srcs[0], 2) | readComponents(s, ins.srcs[1], 2) | readComponents(s, ins.srcs[2], 4);
+          } else {
+            all(4);
+          }
+          break;
+        case op::M4x4: case op::M4x3: case op::M3x4: case op::M3x3: case op::M3x2: {
+          const uint32_t k = (ins.op == op::M4x4 || ins.op == op::M4x3) ? 4 : 3;
+          if (ins.srcs.size() != 2) { all(4); break; }
+          Param row = ins.srcs[1];
+          row.num += c;
+          t |= readComponents(s, ins.srcs[0], k) | readComponents(s, row, k);
+          break;
+        }
+        default:
+          // Scalar ops (rcp, rsq, exp, log, pow, sincos, ...) read a replicated component;
+          // anything else is treated as "every component of every source".
+          all(4);
+          break;
+        }
+        return t;
+      }
+
+      void writeInstruction(State& s, const Instr& ins, const Sources& control, bool nested) {
+        const bool keepOld = nested || ins.predicated;
+        Sources extra = control;
+        if (ins.predicated) extra |= readComponents(s, ins.pred, 4);
+
+        std::array<Sources, 4> values;
+        for (uint32_t c = 0; c < 4; c++) {
+          if (ins.dst.bits & (1u << c)) values[c] = componentSources(s, ins, c) | extra;
+        }
+        for (uint32_t c = 0; c < 4; c++) {
+          if (!(ins.dst.bits & (1u << c))) continue;
+          Sources* d = destination(s, ins.dst, c);
+          if (!d) { m_ok = false; return; }
+          *d = keepOld ? (*d | values[c]) : values[c];
+        }
+      }
+
+      // Runs instructions [begin, end). Returns false when a top-level `ret` ends the program.
+      bool execute(size_t begin, size_t end, State& s, Sources control, bool nested) {
+        for (size_t i = begin; i < end && m_ok; i++) {
+          const Instr& ins = m_code[i];
+          switch (ins.op) {
+          case op::If: case op::Ifc: {
+            Sources cond = control;
+            for (const auto& src : ins.srcs) cond |= readComponents(s, src, 4);
+            const size_t mid = m_partner[i];
+            const size_t stop = m_code[mid].op == op::Else ? m_partner[mid] : mid;
+            execute(i + 1, mid, s, cond, true);
+            if (mid != stop) execute(mid + 1, stop, s, cond, true);
+            i = stop;
+            break;
+          }
+          case op::Loop: case op::Rep: {
+            const size_t stop = m_partner[i];
+            Sources cond = control;
+            for (const auto& src : ins.srcs) cond |= readComponents(s, src, 4);
+            if (ins.op == op::Loop) s.loopCounter |= cond;
+            for (int iteration = 0;; iteration++) {
+              if (iteration == 64) { m_ok = false; break; }
+              const State before = s;
+              execute(i + 1, stop, s, cond | m_breakConditions, true);
+              if (s == before) break;
+            }
+            i = stop;
+            break;
+          }
+          case op::BreakC: case op::BreakP:
+            for (const auto& src : ins.srcs) m_breakConditions |= readComponents(s, src, 4);
+            control |= m_breakConditions;
+            break;
+          case op::Break: case op::Nop:
+            break;
+          case op::Ret:
+            if (!nested) return false;
+            m_ok = false;
+            break;
+          default:
+            if (ins.hasDst) writeInstruction(s, ins, control, nested);
+            break;
+          }
+        }
+        return true;
+      }
+
+      int outputRegister(uint32_t usage, uint32_t index) const {
+        for (uint32_t o = 0; o < kMaxOutputs; o++) {
+          if (m_outputUsage[o] == int(usage | (index << 8))) return int(o);
+        }
+        return -1;
+      }
+
+      void findNormalOutput(const State& s, DxsoCaptureAnalysis& result) const {
+        // A NORMAL0 output is used as-is (stock Remix behaviour).
+        if (outputRegister(kUsageNormal, 0) >= 0) {
+          result.hasNormalOutput = true;
+          result.normalOutputUsage = kUsageNormal;
+          result.normalOutputIndex = 0;
+          return;
+        }
+        int normalInput = -1;
+        int blendIndicesInput = -1;
+        int blendWeightInput = -1;
+        Sources allowed;
+        for (uint32_t v = 0; v < kMaxInputs; v++) {
+          const int u = m_inputUsage[v];
+          if (u < 0) continue;
+          const uint32_t usage = u & 0xFF, index = uint32_t(u) >> 8;
+          if (usage == kUsageNormal && index == 0) normalInput = int(v);
+          if (usage == kUsageBlendIndices && index == 0) blendIndicesInput = int(v);
+          if (usage == kUsageBlendWeight && index == 0) blendWeightInput = int(v);
+          if ((usage == kUsageNormal && index == 0) || usage == kUsageBlendIndices || usage == kUsageBlendWeight) {
+            allowed.set(inputBit(v));
+          }
+        }
+        if (normalInput < 0) return;
+
+        // The output whose xyz is built only from the input normal (plus skinning
+        // weights/indices and constants) is the transformed normal.
+        Sources inputMask;
+        for (uint32_t v = 0; v < kMaxInputs; v++) inputMask.set(inputBit(v));
+        for (uint32_t o = 0; o < kMaxOutputs; o++) {
+          const int u = m_outputUsage[o];
+          if (u < 0 || (u & 0xFF) == kUsagePosition || (m_outputMask[o] & 0x7) != 0x7) continue;
+          bool isNormal = true;
+          for (uint32_t c = 0; c < 3 && isNormal; c++) {
+            const Sources inputs = s.outputs[o * 4 + c] & inputMask;
+            isNormal = inputs.test(inputBit(normalInput)) && (inputs & ~allowed).none();
+          }
+          if (isNormal) {
+            result.hasNormalOutput = true;
+            result.normalOutputUsage = uint8_t(u & 0xFF);
+            result.normalOutputIndex = uint8_t(uint32_t(u) >> 8);
+            return;
+          }
+        }
+
+        // Forward-lit / SH / water / foliage world shaders consume NORMAL0 internally without
+        // emitting a normal output semantic. Record how to synthesize the smooth normal in SPIR-V.
+        bool isWorld = false;
+        const CtabEntry* bonesEntry = nullptr;
+        const CtabEntry* localToWorldEntry = nullptr;
+        for (const auto& e : m_ctab) {
+          if (e.set != 2) continue;
+          if (e.name == "gWorldToProj") isWorld = true;
+          else if (e.name == "gBones") bonesEntry = &e;
+          else if (e.name == "gLocalToWorld") localToWorldEntry = &e;
+        }
+        if (!isWorld) return;
+
+        result.hasSynthesizedNormal = true;
+        result.synthNormalInputReg = uint8_t(normalInput);
+        result.synthNormalPacked01 = true;
+        if (bonesEntry && blendIndicesInput >= 0 && blendWeightInput >= 0) {
+          result.synthHasSkinning = true;
+          result.synthBlendIndicesReg = uint8_t(blendIndicesInput);
+          result.synthBlendWeightReg = uint8_t(blendWeightInput);
+          result.synthBonesFirstReg = bonesEntry->first;
+          result.synthBonesCount = bonesEntry->count;
+          result.synthBoneIndexScale = 765.0f;
+          for (const auto& ins : m_code) {
+            if (ins.op == op::Mul && ins.srcs.size() == 2) {
+              const Param* lit = nullptr;
+              if (ins.srcs[0].type == reg::Input && int(ins.srcs[0].num) == blendIndicesInput &&
+                  ins.srcs[1].type == reg::Const && !ins.srcs[1].relative && m_defined.test(ins.srcs[1].num)) {
+                lit = &ins.srcs[1];
+              } else if (ins.srcs[1].type == reg::Input && int(ins.srcs[1].num) == blendIndicesInput &&
+                         ins.srcs[0].type == reg::Const && !ins.srcs[0].relative && m_defined.test(ins.srcs[0].num)) {
+                lit = &ins.srcs[0];
+              }
+              if (lit) {
+                const float sc = m_defValues[lit->num][swizzleComp(lit->bits, 0)];
+                if (sc > 0.0f) result.synthBoneIndexScale = sc;
+                break;
+              }
+            }
+          }
+        } else if (localToWorldEntry && localToWorldEntry->count >= 3) {
+          result.synthHasLocalToWorld = true;
+          result.synthLocalToWorldFirstReg = localToWorldEntry->first;
+        }
+      }
+
+      static bool nameIn(const std::string& name, const char* const* list, size_t count) {
+        for (size_t k = 0; k < count; k++) if (name == list[k]) return true;
+        return false;
+      }
+
+      void findGeometryConstants(const State& s, DxsoCaptureAnalysis& result) const {
+        const int position = outputRegister(kUsagePosition, 0);
+        if (position < 0) return;
+
+        bool hasObjectMotion = false;
+        for (const auto& e : m_ctab) {
+          if (e.set == 2 && nameIn(e.name, kObjectMotionConstants, std::size(kObjectMotionConstants))) hasObjectMotion = true;
+        }
+        if (!hasObjectMotion) return;
+
+        Sources slice;
+        for (uint32_t c = 0; c < 4; c++) slice |= s.outputs[position * 4 + c];
+
+        std::bitset<kMaxFloatConsts> hashed, covered;
+        for (const auto& e : m_ctab) {
+          if (e.set != 2) continue;
+          bool reaches = false;
+          for (uint32_t r = e.first; r < uint32_t(e.first) + e.count && r < kMaxFloatConsts; r++) {
+            covered.set(r);
+            reaches |= slice.test(constBit(r));
+          }
+          const bool cameraOnly = nameIn(e.name, kCameraOnlyConstants, std::size(kCameraOnlyConstants));
+          const bool objectMotion = nameIn(e.name, kObjectMotionConstants, std::size(kObjectMotionConstants));
+          if ((reaches && !cameraOnly) || objectMotion) {
+            if (reaches && nameIn(e.name, kVertexAnimationConstants, std::size(kVertexAnimationConstants))) {
+              result.hasVertexAnimation = true;
+            }
+            for (uint32_t r = e.first; r < uint32_t(e.first) + e.count && r < kMaxFloatConsts; r++) hashed.set(r);
+          }
+        }
+        // Registers the position reads but the constant table does not describe: keep them.
+        for (uint32_t r = 0; r < kMaxFloatConsts; r++) {
+          if (slice.test(constBit(r)) && !covered.test(r)) hashed.set(r);
+        }
+
+        result.hasGeometryConstantRanges = true;
+        for (uint32_t r = 0; r < kMaxFloatConsts;) {
+          if (!hashed.test(r)) { r++; continue; }
+          const uint32_t first = r;
+          while (r < kMaxFloatConsts && hashed.test(r)) r++;
+          result.geometryConstantRanges.emplace_back(uint16_t(first), uint16_t(r - first));
+        }
+      }
+    };
+
+  }
+
+  DxsoCaptureAnalysis analyzeVertexShaderForCapture(const uint32_t* tokens, size_t tokenCount) {
+    if (tokens == nullptr) {
+      return {};
+    }
+    return Analyzer(tokens, tokenCount).run();
+  }
+
+}
