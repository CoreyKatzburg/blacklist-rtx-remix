+#include <cstdint>
+#include <utility>
+#include <vector>
+
+// NV-DXVK start: vertex capture analysis
+//
+// Reads raw vs_3_0 bytecode and works out, once per shader, two facts that vertex
+// capture needs. It has no dxvk dependencies so the offline tests can run it over
+// every shader the game ships.
+//
+// 1. Which float constants can change the captured world-space vertex positions.
+//    The geometry hash uses only these, so a camera move does not mark static
+//    meshes as changed and rebuild their BLAS.
+// 2. Which shader output holds the transformed (skinned, world-space) vertex normal.
+//    Games often pass it to the pixel shader in a TEXCOORD output instead of NORMAL.
+//
+// The analysis follows data flow per register component: for every output it
+// records which inputs and constants its value can come from. Branches and loops
+// are handled conservatively (writes inside them never discard earlier sources,
+// and branch conditions feed every value written inside the branch).
+
+namespace dxvk {
+
+  struct DxsoCaptureAnalysis {
+    // False when the bytecode could not be analysed (unsupported instruction,
+    // malformed tokens). Callers then keep the stock behaviour.
+    bool valid = false;
+
+    // Output semantic that holds the transformed vertex normal.
+    bool hasNormalOutput = false;
+    uint8_t normalOutputUsage = 0;   // D3DDECLUSAGE value, e.g. 5 = TEXCOORD
+    uint8_t normalOutputIndex = 0;
+
+    // Synthesized smooth normal when a world vertex shader consumes NORMAL0 internally
+    // (e.g. Blacklist forward SH / gear-light shader vs_87D8E2DF, water, or foliage)
+    // without writing a dedicated normal output semantic.
+    bool hasSynthesizedNormal = false;
+    uint8_t synthNormalInputReg = 0;
+    bool synthNormalPacked01 = false;
+    bool synthHasSkinning = false;
+    uint8_t synthBlendIndicesReg = 0;
+    uint8_t synthBlendWeightReg = 0;
+    uint16_t synthBonesFirstReg = 0;
+    uint16_t synthBonesCount = 0;
+    float synthBoneIndexScale = 765.0f;
+    bool synthHasLocalToWorld = false;
+    uint16_t synthLocalToWorldFirstReg = 0;
+
+    // Float constant ranges [first, first + count) that can move captured vertices.
+    // Empty with hasGeometryConstantRanges == false means "hash every constant".
+    bool hasGeometryConstantRanges = false;
+    std::vector<std::pair<uint16_t, uint16_t>> geometryConstantRanges;
+
+    // True when non-skinned vertex animation constants (wind sway, water waves) move positions.
+    bool hasVertexAnimation = false;
+  };
+
+  DxsoCaptureAnalysis analyzeVertexShaderForCapture(const uint32_t* tokens, size_t tokenCount);
+
+}
