+    std::string encodeBase64(const uint8_t* data, size_t len) {
+      static constexpr char kAlphabet[] =
+        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+      std::string out;
+      out.resize(((len + 2) / 3) * 4);
+      size_t j = 0;
+      size_t i = 0;
+      for (; i + 3 <= len; i += 3) {
+        const uint32_t v = (uint32_t(data[i]) << 16) | (uint32_t(data[i + 1]) << 8) | uint32_t(data[i + 2]);
+        out[j++] = kAlphabet[(v >> 18) & 0x3Fu];
+        out[j++] = kAlphabet[(v >> 12) & 0x3Fu];
+        out[j++] = kAlphabet[(v >> 6) & 0x3Fu];
+        out[j++] = kAlphabet[v & 0x3Fu];
+      }
+      if (i < len) {
+        uint32_t v = uint32_t(data[i]) << 16;
+        if (i + 1 < len) {
+          v |= uint32_t(data[i + 1]) << 8;
+        }
+        out[j++] = kAlphabet[(v >> 18) & 0x3Fu];
+        out[j++] = kAlphabet[(v >> 12) & 0x3Fu];
+        out[j++] = (i + 1 < len) ? kAlphabet[(v >> 6) & 0x3Fu] : '=';
+        out[j++] = '=';
+      }
+      return out;
+    }
